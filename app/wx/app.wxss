/* app.wxss — 全局样式变量与基础组件 */
@import "styles/tokens.wxss";
page {
  background-color: #F5F3F0;
  font-family: PingFang SC, -apple-system, sans-serif;
  color: #1C1C1E;
  box-sizing: border-box;
  height: 100%;
}

/* ── 按钮 ── */
.btn-primary {
  background: #4A7B7B;
  color: #ffffff;
  height: 104rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  width: 100%;
  border: none;
}

.btn-primary.disabled {
  background: #E8E4DE;
  color: #ABABAB;
}

.btn-secondary {
  background: transparent;
  color: #4A7B7B;
  border: 2rpx solid #4A7B7B;
  height: 104rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  width: 100%;
}

.btn-ghost {
  background: transparent;
  color: #6B6B6B;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  width: 100%;
}

/* ── 卡片 ── */
.card {
  background: #FAFAF8;
  border: 1rpx solid #E8E4DE;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 24rpx rgba(0,0,0,0.06);
}

/* ── 状态徽章 ── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.badge-green { background: #EDF6F0; color: #2A5C40; }
.badge-yellow { background: #FDF6E3; color: #7A5820; }
.badge-red { background: #FBF0F0; color: #7A2A2A; }
