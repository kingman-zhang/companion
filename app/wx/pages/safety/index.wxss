/* P8 安全拦截页 — 玫瑰粉色系 */

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  padding-bottom: 80rpx;
}

/* ── 关怀区域 ── */
.care-section {
  padding: 120rpx 40rpx 48rpx;
  text-align: center;
}

.care-icon-wrap {
  margin-bottom: 32rpx;
}

.care-icon {
  font-size: 96rpx;
}

.care-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.care-subtitle {
  display: block;
  font-size: 30rpx;
  color: #52464A;
  line-height: 1.7;
}

/* 冷静期提示 */
.cooldown-tip {
  margin: 28rpx 0 0;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #FFF4F7 0%, #FCE8EE 100%);
  display: inline-block;
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.cooldown-text {
  font-size: 24rpx;
  color: #C73E64;
  line-height: 1.6;
}

/* ── 资源区 ── */
.resources {
  padding: 0 40rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #8F8589;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.hotline-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 16rpx 36rpx rgba(117, 77, 76, 0.06);
}

.card-hover { opacity: 0.82; }

.hotline-info {
  flex: 1;
  min-width: 0;
}

.hotline-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F1417;
  margin-bottom: 6rpx;
}

.hotline-desc {
  display: block;
  font-size: 22rpx;
  color: #8F8589;
}

.hotline-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.hotline-phone {
  font-size: 28rpx;
  font-weight: 600;
  color: #E45A7E;
}

.hotline-arrow {
  font-size: 28rpx;
  color: #E45A7E;
}

/* ── 底部提示 ── */
.bottom-tip {
  text-align: center;
  padding: 40rpx 40rpx 16rpx;
}

.bottom-tip-text {
  font-size: 26rpx;
  color: #BDB3B5;
  line-height: 1.6;
}

/* ── 按钮 ── */
.footer-btn {
  padding: 0 40rpx;
}

.btn-ok {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.btn-ok-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.btn-hover { opacity: 0.82; }
