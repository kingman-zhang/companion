<!-- P8 安全拦截页 -->
<scroll-view class="page" scroll-y type="list">

  <!-- 顶部关怀区域 -->
  <view class="care-section">
    <view class="care-icon-wrap">
      <text class="care-icon">🫂</text>
    </view>
    <text class="care-title">我注意到你现在可能很难受</text>
    <text class="care-subtitle">你的感受很重要。现在先联系专业支持，会比一个人扛着更有帮助。</text>

    <!-- 冷静期提示（有 cooldown 时显示）-->
    <view wx:if="{{cooldownTip}}" class="cooldown-tip">
      <text class="cooldown-text">{{cooldownTip}}</text>
    </view>
  </view>

  <!-- 资源卡片 -->
  <view class="resources">
    <text class="section-label">可以联系的支持热线</text>

    <view
      wx:for="{{hotlines}}"
      wx:key="name"
      class="hotline-card"
      bindtap="callHotline"
      data-phone="{{item.phone}}"
      hover-class="card-hover"
      hover-stay-time="100"
    >
      <view class="hotline-info">
        <text class="hotline-name">{{item.name}}</text>
        <text class="hotline-desc">{{item.desc}}</text>
      </view>
      <view class="hotline-right">
        <text class="hotline-phone">{{item.phone}}</text>
        <text class="hotline-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="bottom-tip">
    <text class="bottom-tip-text">你不是一个人在面对这些事</text>
  </view>

  <!-- 返回按钮 -->
  <view class="footer-btn">
    <view class="btn-ok" bindtap="goHome" hover-class="btn-hover" hover-stay-time="100">
      <text class="btn-ok-text">回到首页</text>
    </view>
  </view>

  <view style="height: env(safe-area-inset-bottom, 40rpx);"></view>

</scroll-view>
