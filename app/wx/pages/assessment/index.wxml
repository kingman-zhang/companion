<!-- P2 评估结果页 -->
<scroll-view class="page" scroll-y>

  <!-- ── 自定义导航栏 ── -->
  <view class="nav-bar" style="padding-top: {{navPaddingTop}}; height: {{navBarHeight}};">
    <view class="nav-back-btn" bindtap="goHome" hover-class="nav-btn-hover" hover-stay-time="100">
      <image src="/assets/icons/home.svg" class="nav-home-icon" mode="aspectFit"/>
    </view>
    <text class="nav-title">关系评估</text>
    <view class="nav-more" style="width: {{navPaddingRight}};">
      <view class="nav-more-btn" bindtap="showMore" hover-class="nav-btn-hover" hover-stay-time="80">
        <text class="nav-more-text">⋯</text>
      </view>
    </view>
  </view>

  <!-- ── 评分总览卡片 ── -->
  <view class="score-card">

    <!-- 徽章 + 分数 -->
    <view class="score-header">
      <view class="score-left">
        <view class="level-badge badge-{{levelClass}}">
          <text class="level-badge-text">{{levelBadge}}</text>
        </view>
        <text class="score-title">{{scoreTitle}}</text>
      </view>
      <view class="score-right">
        <view class="score-num-row">
          <text class="score-num score-num-{{levelClass}}">{{result.score}}</text>
          <text class="score-unit">/100</text>
        </view>
        <text class="score-label">关系健康度</text>
      </view>
    </view>

    <!-- 三维度进度条 -->
    <view class="dimensions">
      <view class="dim-item">
        <view class="dim-row">
          <text class="dim-name">情感联结</text>
          <text class="dim-score dim-score-{{emoClass}}">{{result.emotional_connection_score}}</text>
        </view>
        <view class="dim-track">
          <view class="dim-fill dim-fill-{{emoClass}}" style="width: {{result.emotional_connection_score}}%"></view>
        </view>
      </view>
      <view class="dim-item">
        <view class="dim-row">
          <text class="dim-name">沟通质量</text>
          <text class="dim-score dim-score-{{commClass}}">{{result.communication_score}}</text>
        </view>
        <view class="dim-track">
          <view class="dim-fill dim-fill-{{commClass}}" style="width: {{result.communication_score}}%"></view>
        </view>
      </view>
      <view class="dim-item">
        <view class="dim-row">
          <text class="dim-name">冲突处理</text>
          <text class="dim-score dim-score-{{conflictClass}}">{{result.conflict_score}}</text>
        </view>
        <view class="dim-track">
          <view class="dim-fill dim-fill-{{conflictClass}}" style="width: {{result.conflict_score}}%"></view>
        </view>
      </view>
    </view>

  </view>

  <!-- ── 核心洞察（粉色卡片）── -->
  <view class="insight-card">
    <text class="insight-label">核心洞察</text>
    <text class="insight-quote">"{{result.core_insight}}"</text>
    <text class="insight-desc">{{result.llm_reason}}</text>
  </view>

  <!-- ── 接下来可以 ── -->
  <view class="actions-section">
    <text class="actions-title">接下来可以：</text>
    <view class="action-list">

      <!-- 行动1：主操作（粉色边框，可展开） -->
      <view class="action-card action-card-primary">
        <view class="action-header" bindtap="toggleAction" data-id="chat" hover-class="action-hover" hover-stay-time="80">
          <view class="action-num action-num-primary">
            <text class="action-num-text-white">1</text>
          </view>
          <view class="action-content">
            <text class="action-title-text">{{action1Title}}</text>
            <text class="action-desc-text">和 AI 聊 · 大约 10 分钟</text>
          </view>
          <view class="chev-wrap {{expandedAction === 'chat' ? 'chev-up' : ''}}">
            <text class="action-chev">›</text>
          </view>
        </view>
        <view wx:if="{{expandedAction === 'chat'}}" class="action-detail">
          <text class="action-detail-text">先不做任何关系上的决定。用 AI 帮你把卡在心里的话说出来，情绪稳了之后再往下走。</text>
          <view class="action-cta" bindtap="goChat" hover-class="cta-hover" hover-stay-time="80">
            <text class="action-cta-text">开始对话 →</text>
          </view>
        </view>
      </view>

      <!-- 行动2（可展开） -->
      <view class="action-card">
        <view class="action-header" bindtap="toggleAction" data-id="rewrite" hover-class="action-hover" hover-stay-time="80">
          <view class="action-num action-num-secondary">
            <text class="action-num-text-gray">2</text>
          </view>
          <view class="action-content">
            <text class="action-title-text">生成一条给 TA 的话</text>
            <text class="action-desc-text">基于你的评估定制 · 3 个版本</text>
          </view>
          <view class="chev-wrap {{expandedAction === 'rewrite' ? 'chev-up' : ''}}">
            <text class="action-chev">›</text>
          </view>
        </view>
        <view wx:if="{{expandedAction === 'rewrite'}}" class="action-detail">
          <text class="action-detail-text">根据你的目标（修复 / 设边界 / 告别），AI 给你三种不同风险等级的表达，附改写原理。</text>
          <view class="action-cta" bindtap="goRewrite" hover-class="cta-hover" hover-stay-time="80">
            <text class="action-cta-text">去改写 →</text>
          </view>
        </view>
      </view>

      <!-- 行动3：放下模式（红灯/letgo意向激活），否则灰显 -->
      <view class="action-card {{showLetgoAction ? '' : 'action-card-dim'}}">
        <view class="action-header" bindtap="{{showLetgoAction ? 'toggleAction' : 'showComingSoon'}}" data-id="letgo" hover-class="action-hover" hover-stay-time="80">
          <view class="action-num action-num-secondary">
            <text class="action-num-text-gray">3</text>
          </view>
          <view class="action-content">
            <text class="action-title-text">{{showLetgoAction ? '放下模式' : '开启 14 天恢复计划'}}</text>
            <text class="action-desc-text">{{showLetgoAction ? '断联建议 · 告别信 · 7天恢复' : '每日任务 · 可随时暂停'}}</text>
          </view>
          <text class="action-chev {{showLetgoAction ? '' : 'action-chev-dim'}} {{expandedAction === 'letgo' ? 'chev-up-inline' : ''}}">›</text>
        </view>
        <view wx:if="{{showLetgoAction && expandedAction === 'letgo'}}" class="action-detail">
          <text class="action-detail-text">先照顾好自己。断开联系、写出感受、用 7 天一步步找回状态。这不是放弃，是更好地重新开始。</text>
          <view class="action-cta" bindtap="goLetgo" hover-class="cta-hover" hover-stay-time="80">
            <text class="action-cta-text">进入放下模式 →</text>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- ── 免责声明 ── -->
  <view class="disclaimer-row">
    <text class="disclaimer-icon">ⓘ</text>
    <text class="disclaimer-text">此评估基于你提供的信息 · 仅供参考 · 不替代专业心理咨询。如果你有自伤念头，请拨打 400-161-9995。</text>
  </view>

  <!-- ── 底部文字链接 ── -->
  <view class="page-footer">
    <text class="footer-link" bindtap="goRedo" hover-class="footer-hover" hover-stay-time="80">重新评估 / 修改答案</text>
  </view>

</scroll-view>
