/* P2 评估结果页 — 玫瑰粉色系 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 35%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 46%, #F6EEEA 100%);
}

/* ── 自定义导航栏 ── */
.nav-bar {
  background: rgba(250, 241, 237, 0.92);
  display: flex;
  align-items: flex-end;
  padding-left: 32rpx;
  padding-bottom: 12rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-sizing: border-box;
  backdrop-filter: blur(18rpx);
}

.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(219, 200, 195, 0.72);
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.06);
}

.nav-btn-hover { opacity: 0.7; }

.nav-home-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.nav-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.2;
}

.nav-subtitle {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}

.nav-more {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-right: 32rpx;
}

.nav-more-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(219, 200, 195, 0.72);
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.06);
}

.nav-more-text {
  font-size: 28rpx;
  color: #52464A;
}

.share-entry {
  margin: 18rpx 32rpx 0;
  height: 76rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(228, 90, 126, 0.18);
  background: rgba(255, 244, 247, 0.92);
  color: #C84E73;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
  box-shadow: 0 12rpx 30rpx rgba(199, 62, 100, 0.06);
}

.share-entry::after {
  border: none;
}

/* ══════════════════════════
   评分总览卡片
══════════════════════════ */
.score-card {
  margin: 16rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 36rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  box-shadow: 0 20rpx 50rpx rgba(117, 77, 76, 0.08);
  backdrop-filter: blur(18rpx);
}

/* 顶行：左（徽章+标题）右（分数）*/
.score-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.score-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 等级徽章 */
.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  align-self: flex-start;
  border: 1rpx solid transparent;
}

.badge-green  { background: #E3EEDF; border-color: rgba(61, 122, 90, 0.16); }
.badge-yellow { background: #FDF6E3; border-color: rgba(160, 120, 48, 0.16); }
.badge-red    { background: #FBF0F0; border-color: rgba(155, 64, 64, 0.16); }

.level-badge-text {
  font-size: 22rpx;
  font-weight: 600;
}

.badge-green  .level-badge-text { color: #3D7A5A; }
.badge-yellow .level-badge-text { color: #A07830; }
.badge-red    .level-badge-text { color: #9B4040; }

/* 卡片标题 */
.score-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.4;
}

/* 右侧分数 */
.score-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.score-num-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.score-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}

.score-num-green  { color: #3D7A5A; }
.score-num-yellow { color: #A07830; }
.score-num-red    { color: #9B4040; }

.score-unit {
  font-size: 24rpx;
  color: #8F8589;
  font-weight: 400;
}

.score-label {
  font-size: 20rpx;
  color: #8F8589;
}

/* ── 三维度进度条 ── */
.dimensions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.dim-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dim-name {
  font-size: 24rpx;
  color: #52464A;
}

.dim-score {
  font-size: 24rpx;
  font-weight: 600;
}

.dim-score-green  { color: #3D7A5A; }
.dim-score-yellow { color: #A07830; }
.dim-score-red    { color: #9B4040; }

.dim-track {
  height: 10rpx;
  background: rgba(228, 214, 209, 0.88);
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 999rpx;
}

.dim-fill-green  { background: linear-gradient(135deg, #4E936A 0%, #3D7A5A 100%); }
.dim-fill-yellow { background: linear-gradient(135deg, #C28E34 0%, #A07830 100%); }
.dim-fill-red    { background: linear-gradient(135deg, #B45858 0%, #9B4040 100%); }

/* ══════════════════════════
   核心洞察卡片（粉色）
══════════════════════════ */
.insight-card {
  margin: 28rpx 32rpx 0;
  padding: 30rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFF4F7 0%, #FCE8EE 100%);
  border: 1rpx solid rgba(228, 90, 126, 0.14);
  box-shadow: 0 16rpx 36rpx rgba(199, 62, 100, 0.08);
}

.insight-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #E45A7E;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.insight-quote {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.insight-desc {
  display: block;
  font-size: 24rpx;
  color: #52464A;
  line-height: 1.7;
}

.insight-foot {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(228, 90, 126, 0.12);
}

.insight-foot-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1.6;
}

/* ══════════════════════════
   行动卡片
══════════════════════════ */
.actions-section {
  margin: 32rpx 32rpx 0;
}

.actions-title {
  display: block;
  font-size: 24rpx;
  color: #52464A;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  overflow: hidden;
  box-shadow: 0 14rpx 34rpx rgba(117, 77, 76, 0.05);
}

.action-card-primary {
  border-color: rgba(228, 90, 126, 0.26);
  box-shadow: 0 16rpx 36rpx rgba(199, 62, 100, 0.08);
}

.action-card-dim {
  opacity: 0.45;
}

.action-header {
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-hover { opacity: 0.92; }

/* 序号圆圈 */
.action-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-num-primary  { background: #E45A7E; }
.action-num-secondary {
  background: rgba(255, 255, 255, 0.9);
  border: 1.5rpx solid rgba(228, 210, 205, 0.84);
}

.action-num-text-white {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
}

.action-num-text-gray {
  font-size: 24rpx;
  font-weight: 600;
  color: #8F8589;
  line-height: 1;
}

.action-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.action-title-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F1417;
  line-height: 1.4;
}

.action-desc-text {
  font-size: 22rpx;
  color: #8F8589;
}

.chev-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.chev-up {
  transform: rotate(-90deg);
}

.action-chev {
  font-size: 32rpx;
  color: #BDB3B5;
  line-height: 1;
  padding-left: 8rpx;
}

.action-chev-dim {
  color: #D8D2CE;
}

/* 展开详情区 */
.action-detail {
  padding: 0 24rpx 24rpx;
}

.action-detail-text {
  display: block;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #FCF6F3;
  font-size: 24rpx;
  color: #52464A;
  line-height: 1.7;
}

.action-cta {
  margin-top: 16rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.cta-hover { opacity: 0.82; }

.action-cta-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ══════════════════════════
   免责声明
══════════════════════════ */
.disclaimer-row {
  margin: 28rpx 32rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(250, 240, 220, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(200, 138, 63, 0.14);
}

.disclaimer-icon {
  font-size: 26rpx;
  color: #C88A3F;
  flex-shrink: 0;
  line-height: 1.5;
}

.disclaimer-text {
  font-size: 20rpx;
  color: #8A5A20;
  line-height: 1.7;
  flex: 1;
}

/* ══════════════════════════
   底部操作文字链接
══════════════════════════ */
.page-footer {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom, 0px) + 40rpx);
  display: flex;
  justify-content: center;
}

.footer-link {
  font-size: 24rpx;
  color: #BDB3B5;
  line-height: 1.6;
}

.footer-hover { opacity: 0.6; }
