/* P2 评估结果页 */

.page {
  min-height: 100vh;
  background: #EDE8DC;
}

/* ── 自定义导航栏 ── */
.nav-bar {
  background: #EDE8DC;
  display: flex;
  align-items: flex-end;
  padding-left: 16rpx;
  padding-bottom: 12rpx;
  padding-right: 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-sizing: border-box;
}

.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 1.5rpx solid #D8D3CA;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-btn-hover { opacity: 0.7; }

.nav-home-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  line-height: 60rpx;
}

/* ══════════════════════════
   评分总览卡片
══════════════════════════ */
.score-card {
  margin: 24rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 32rpx;
}

/* 顶行：徽章左 + 分数右 */
.score-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* 等级徽章 */
.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.badge-green  { background: #D6EFDF; }
.badge-yellow { background: #FDEBC8; }
.badge-red    { background: #FDDADA; }

.level-badge-text {
  font-size: 22rpx;
  font-weight: 600;
}

.badge-green  .level-badge-text { color: #2E6B4A; }
.badge-yellow .level-badge-text { color: #A06010; }
.badge-red    .level-badge-text { color: #A03030; }

/* 右侧分数 */
.score-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.score-num-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.score-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.score-num-green  { color: #2E6B4A; }
.score-num-yellow { color: #B06818; }
.score-num-red    { color: #A03030; }

.score-unit {
  font-size: 20rpx;
  color: #8A8478;
  font-weight: 400;
}

.score-label {
  font-size: 20rpx;
  color: #A0A0A0;
}

/* 卡片标题 */
.score-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

/* ── 三维度进度条 ── */
.dimensions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dim-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dim-name {
  font-size: 24rpx;
  color: #5A5650;
}

.dim-score {
  font-size: 24rpx;
  font-weight: 600;
}

.dim-score-green  { color: #2E6B4A; }
.dim-score-yellow { color: #B06818; }
.dim-score-red    { color: #A03030; }

.dim-track {
  height: 8rpx;
  background: #EDE8DE;
  border-radius: 4rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 4rpx;
}

.dim-fill-green  { background: #3D7A5A; }
.dim-fill-yellow { background: #C07820; }
.dim-fill-red    { background: #B04040; }

/* ══════════════════════════
   核心洞察
══════════════════════════ */
.insight-section {
  margin: 36rpx 32rpx 0;
}

.insight-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #4A7B7B;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.insight-quote {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.insight-desc {
  display: block;
  font-size: 24rpx;
  color: #8A8478;
  line-height: 1.7;
}

/* ══════════════════════════
   行动卡片
══════════════════════════ */
.actions-section {
  margin: 32rpx 32rpx 0;
}

.actions-title {
  display: block;
  font-size: 24rpx;
  color: #5A5650;
  margin-bottom: 16rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-hover { opacity: 0.8; }

.action-card-dim { opacity: 0.5; }

.action-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.action-num-primary  { background: #4A7B7B; }
.action-num-secondary {
  background: transparent;
  border: 1.5rpx solid #C8C4BC;
}

.action-num-text {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.action-num-primary  .action-num-text { color: #FFFFFF; }
.action-num-secondary .action-num-text { color: #8A8478; }

.action-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.action-title-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
  line-height: 1.4;
}

.action-desc-text {
  font-size: 22rpx;
  color: #A8A49E;
}

.action-arrow {
  font-size: 36rpx;
  color: #C8C4BC;
  flex-shrink: 0;
  line-height: 1;
}

/* ══════════════════════════
   免责声明
══════════════════════════ */
.disclaimer-row {
  margin: 28rpx 32rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #FEF5E6;
  border-radius: 16rpx;
  padding: 20rpx;
}

.disclaimer-icon {
  font-size: 26rpx;
  color: #C07820;
  flex-shrink: 0;
  line-height: 1.5;
}

.disclaimer-text {
  font-size: 20rpx;
  color: #8A7450;
  line-height: 1.7;
  flex: 1;
}

/* ══════════════════════════
   底部操作文字链接
══════════════════════════ */
.page-footer {
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom, 0px) + 32rpx);
  display: flex;
  justify-content: center;
}

.footer-link {
  font-size: 24rpx;
  color: #A8A49E;
  line-height: 1.6;
}
