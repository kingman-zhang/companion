<!-- P4 消息改写页 -->
<view class="page">

  <!-- ── 顶部导航 ── -->
  <view class="nav-bar" style="padding-top: {{navPaddingTop}}; padding-right: {{navPaddingRight || '200rpx'}};">
    <view class="nav-back-btn" bindtap="goBack" hover-class="nav-btn-hover" hover-stay-time="100">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">消息改写</text>
      <text class="nav-subtitle">{{hasResults ? goalLabels[selectedGoal] : (showHistory ? '过往改写' : '发出去前先过一遍')}}</text>
    </view>
  </view>

  <view class="top-action-strip" wx:if="{{!showHistory}}">
    <view class="top-action-pill" wx:if="{{hasResults}}" bindtap="resetPage" hover-class="nav-btn-hover" hover-stay-time="80">
      <text class="nav-action-text">重新写</text>
    </view>
    <view class="top-action-pill top-action-pill-primary" bindtap="openHistory" hover-class="nav-btn-hover" hover-stay-time="80">
      <text class="nav-action-text nav-history-text">历史</text>
    </view>
  </view>

  <!-- ══════════════════════
       输入状态（未生成结果）
  ══════════════════════ -->
  <block wx:if="{{!hasResults && !showHistory}}">
    <scroll-view class="content" scroll-y scroll-top="{{contentScrollTop}}">

      <!-- Hero -->
      <view class="hero">
        <text class="hero-title">发出去之前，先一起过一遍</text>
        <text class="hero-desc">告诉我你想达到什么效果，再贴上原话，我会帮你整理出几种不同分寸的说法。</text>
      </view>

      <!-- Step 1：目标选择 -->
      <view class="step-block">
        <view class="step-label-row">
          <view class="step-num step-num-on"><text class="step-num-text">1</text></view>
          <text class="step-label-text">这句话，你想说到哪里</text>
        </view>
        <view class="goal-chips">
          <view
            wx:for="{{goals}}"
            wx:key="id"
            class="goal-chip {{selectedGoal === item.id ? 'goal-chip-on' : 'goal-chip-off'}}"
            bindtap="selectGoal"
            data-id="{{item.id}}"
            hover-class="chip-hover"
            hover-stay-time="80"
          >
            <text class="goal-chip-text {{selectedGoal === item.id ? 'goal-chip-text-on' : ''}}">{{item.title}}</text>
          </view>
        </view>
        <text class="goal-sub">{{goalSub}}</text>
      </view>

      <!-- Step 2：原文输入 -->
      <view class="step-block">
        <view class="step-label-row">
          <view class="step-num {{originalMessage ? 'step-num-on' : 'step-num-off'}}">
            <text class="step-num-text">2</text>
          </view>
          <text class="step-label-text">把你写的原话贴进来</text>
        </view>
        <view class="input-card {{originalMessage ? 'input-card-active' : ''}}">
          <textarea
            class="original-textarea"
            value="{{originalMessage}}"
            bindinput="onInput"
            placeholder="把你打算发出去的那段话贴在这里..."
            placeholder-class="textarea-placeholder"
            auto-height
            maxlength="500"
            adjust-position="{{true}}"
            focus="{{inputFocus}}"
          />
          <view wx:if="{{originalMessage}}" class="input-footer">
            <view class="risk-hint">
              <view class="risk-dot risk-dot-{{riskLevel}}"></view>
              <text class="risk-label-text risk-label-{{riskLevel}}">{{riskLabel}}</text>
            </view>
            <text class="char-count">{{originalMessage.length}} 字</text>
          </view>
        </view>

        <!-- 示例文案（输入为空时显示）-->
        <view wx:if="{{!originalMessage}}" class="examples">
          <text class="examples-title">{{examplesLabel}}</text>
          <view
            wx:for="{{examples}}"
            wx:key="index"
            class="example-item"
            bindtap="fillExample"
            data-text="{{item}}"
            hover-class="chip-hover"
            hover-stay-time="80"
          >
            <text class="example-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view style="height: 160rpx;"></view>
    </scroll-view>

    <!-- 生成按钮（固定底部）-->
    <view class="gen-bar">
      <view
        class="gen-btn {{(!originalMessage || loading) ? 'gen-btn-off' : 'gen-btn-on'}}"
        bindtap="doRewrite"
        hover-class="{{(!originalMessage || loading) ? '' : 'btn-hover'}}"
        hover-stay-time="80"
      >
        <text class="gen-btn-text">{{loading ? '改写中…' : '✦ 改写 3 个版本'}}</text>
      </view>
    </view>
  </block>

  <!-- ══════════════════════
       历史记录
  ══════════════════════ -->
  <scroll-view wx:elif="{{showHistory}}" class="content" scroll-y>
    <view wx:if="{{historyFallback}}" class="hist-fallback-tip">
      <text class="hist-fallback-text">网络暂时不可用，当前只显示本地记录</text>
      <text class="hist-fallback-retry" bindtap="openHistory">再试一次</text>
    </view>
    <view wx:if="{{history.length === 0}}" class="hist-empty">
      <text class="hist-empty-text">还没有改写记录</text>
    </view>
    <view wx:else>
      <view
        wx:for="{{history}}"
        wx:key="rewrite_id"
        class="hist-item"
        bindtap="restoreHistory"
        data-index="{{index}}"
        hover-class="hist-item-hover"
        hover-stay-time="80"
      >
        <view class="hist-item-top">
          <text class="hist-original">{{item.original}}</text>
          <text class="hist-date">{{item.date}}</text>
        </view>
        <text class="hist-result">{{item.result}}</text>
      </view>
    </view>
    <view style="height: 60rpx;"></view>
  </scroll-view>

  <!-- ══════════════════════
       结果状态（已生成）
  ══════════════════════ -->
  <scroll-view wx:else class="content" scroll-y>

    <!-- 原文回显卡 -->
    <view class="echo-card">
      <view class="echo-header">
        <text class="echo-label">你写的版本</text>
        <view class="risk-hint">
          <view class="risk-dot risk-dot-{{riskLevel}}"></view>
          <text class="risk-label-text risk-label-{{riskLevel}}">{{riskLabel}}</text>
        </view>
      </view>
      <text class="echo-text">{{originalMessage}}</text>
    </view>

    <!-- Tab 切换 -->
    <view class="tab-switcher">
      <view
        wx:for="{{variants}}"
        wx:key="version"
        class="tab-item {{activeTab === index ? 'tab-on' : 'tab-off'}}"
        bindtap="setTab"
        data-index="{{index}}"
        hover-class="chip-hover"
        hover-stay-time="80"
      >
        <text class="tab-label {{activeTab === index ? 'tab-label-on' : ''}}">{{item.version_label}}</text>
        <text class="tab-sub tab-sub-{{item.risk_level}}">{{item.risk_text}}</text>
      </view>
    </view>

    <!-- 当前结果卡 -->
    <view class="result-card">
      <text class="result-text">{{currentVariant.content}}</text>

      <!-- 操作行 -->
      <view class="result-actions">
        <view class="action-copy {{copied ? 'action-copy-done' : ''}}" bindtap="copyResult" hover-class="btn-hover" hover-stay-time="80">
          <text class="action-copy-text">{{copied ? '✓ 已复制' : '复制内容'}}</text>
        </view>
        <view class="action-icon-btn" bindtap="doRewrite" hover-class="btn-hover" hover-stay-time="80">
          <text class="action-icon">↻</text>
        </view>
      </view>
    </view>

    <!-- 预测回复 Nudge -->
    <view class="nudge-banner">
      <view class="nudge-icon-wrap">
        <text class="nudge-icon">✦</text>
      </view>
      <view class="nudge-body">
        <text class="nudge-title">顺便想一想 TA 可能怎么回</text>
        <text class="nudge-sub">这个能力还没接上，后面会补成“后续对话预演”</text>
      </view>
      <view class="nudge-btn" hover-class="btn-hover" hover-stay-time="80">
        <text class="nudge-btn-text">即将开放</text>
      </view>
    </view>

    <view style="height: 60rpx;"></view>
  </scroll-view>

</view>
