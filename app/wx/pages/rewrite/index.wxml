<!-- P4 消息改写页 -->
<scroll-view class="page" scroll-y type="list">

  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack" hover-class="nav-hover" hover-stay-time="100">
      <text class="nav-back-icon">‹</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">消息改写</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 原文输入区 -->
  <view class="input-section">
    <text class="section-label">你想发给TA的消息</text>
    <view class="original-input-wrap {{inputFocused ? 'focused' : ''}}">
      <textarea
        class="original-input"
        value="{{originalMessage}}"
        bindinput="onInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        placeholder="把你想说的写在这里，我来帮你表达得更好…"
        placeholder-class="input-placeholder"
        auto-height
        maxlength="500"
        adjust-position="{{true}}"
      />
      <text class="char-count">{{originalMessage.length}} / 500</text>
    </view>
    <view
      class="rewrite-btn {{(!originalMessage || loading) ? 'rewrite-btn-disabled' : ''}}"
      bindtap="doRewrite"
      hover-class="btn-hover"
      hover-stay-time="100"
    >
      <text>{{loading ? '改写中…' : '帮我改写'}}</text>
    </view>
  </view>

  <!-- 改写结果 -->
  <view class="results" wx:if="{{variants.length > 0}}">
    <text class="section-label">改写结果</text>

    <view
      wx:for="{{variants}}"
      wx:key="version"
      class="variant-card {{item.locked ? 'locked' : ''}}"
    >
      <!-- 卡片头部 -->
      <view class="variant-header">
        <view class="version-badge version-{{item.version}}">
          <text class="version-text">{{item.version_label}}</text>
        </view>
        <view class="risk-badge risk-{{item.risk_level}}" wx:if="{{!item.locked}}">
          <text class="risk-text">{{item.risk_text}}</text>
        </view>
      </view>

      <!-- 卡片内容 -->
      <text class="variant-content" wx:if="{{!item.locked}}">{{item.content}}</text>

      <!-- 毛玻璃遮罩（付费锁） -->
      <view class="paywall-overlay" wx:if="{{item.locked}}">
        <view class="lock-icon-wrap">
          <text class="lock-icon">🔒</text>
        </view>
        <text class="lock-title">解锁更多改写方案</text>
        <text class="lock-sub">升级会员查看直接版和简短版</text>
        <view class="lock-btn" bindtap="showUpgrade" hover-class="btn-hover" hover-stay-time="100">
          <text>立即升级</text>
        </view>
      </view>

      <!-- 操作按钮（仅已解锁） -->
      <view class="variant-actions" wx:if="{{!item.locked}}">
        <view wx:if="{{item.send_recommended}}" class="recommend-badge">
          <text class="recommend-text">✓ 建议发送</text>
        </view>
        <view class="copy-btn" bindtap="copyContent" data-content="{{item.content}}" hover-class="btn-hover" hover-stay-time="100">
          <text class="copy-text">复制</text>
        </view>
      </view>
    </view>
  </view>

  <view class="page-bottom"></view>
</scroll-view>
