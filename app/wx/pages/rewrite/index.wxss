/* P4 消息改写页 — 玫瑰粉色系 */

.page {
  height: 100vh;
  background: #FAF4F1;
  display: flex;
  flex-direction: column;
}

/* ══════════════════════════
   导航栏
══════════════════════════ */
.nav-bar {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  background: #FAF4F1;
  border-bottom: 1rpx solid #EFE4E0;
}

.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-btn-hover { opacity: 0.7; }

.nav-back-icon {
  font-size: 44rpx;
  color: #52464A;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.3;
}

.nav-subtitle {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}

.nav-right {
  min-width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.nav-action-text {
  font-size: 24rpx;
  color: #8F8589;
}

.nav-history-text {
  color: #E45A7E;
}

/* ══════════════════════════
   可滚动内容区
══════════════════════════ */
.content {
  flex: 1;
  overflow: hidden;
}

/* ══════════════════════════
   输入状态：Hero
══════════════════════════ */
.hero {
  padding: 32rpx 40rpx 24rpx;
  text-align: center;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.65;
}

/* ── Step 块 ── */
.step-block {
  padding: 0 40rpx 32rpx;
}

.step-label-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.step-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-num-on  { background: #E45A7E; }
.step-num-off { background: #EFE4E0; }

.step-num-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.step-label-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #52464A;
}

/* ── 目标 chips ── */
.goal-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.goal-chip {
  padding: 14rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.goal-chip-on {
  background: #E45A7E;
  border: none;
}

.goal-chip-off {
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
}

.chip-hover { opacity: 0.75; }

.goal-chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #52464A;
}

.goal-chip-text-on {
  color: #FFFFFF;
}

.goal-sub {
  display: block;
  font-size: 22rpx;
  color: #8F8589;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* ── 输入卡片 ── */
.input-card {
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE4E0;
  overflow: hidden;
  transition: border-color 0.2s;
}

.input-card-active {
  border-color: #E45A7E;
}

.original-textarea {
  display: block;
  width: 100%;
  min-height: 180rpx;
  padding: 28rpx 28rpx 16rpx;
  font-size: 30rpx;
  color: #1F1417;
  line-height: 1.7;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #BDB3B5;
  font-size: 30rpx;
}

/* 输入卡片底部：风险 + 字数 */
.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 28rpx 20rpx;
  border-top: 1rpx solid #EFE4E0;
}

/* ── 风险提示（共用）── */
.risk-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.risk-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.risk-dot-low    { background: #3D7A5A; }
.risk-dot-medium { background: #A07830; }
.risk-dot-high   { background: #9B4040; }

.risk-label-text {
  font-size: 22rpx;
  font-weight: 500;
}

.risk-label-low    { color: #3D7A5A; }
.risk-label-medium { color: #A07830; }
.risk-label-high   { color: #9B4040; }

.char-count {
  font-size: 22rpx;
  color: #BDB3B5;
}

/* ── 示例 ── */
.examples {
  margin-top: 20rpx;
}

.examples-title {
  display: block;
  font-size: 22rpx;
  color: #8F8589;
  margin-bottom: 14rpx;
}

.example-item {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1.5rpx dashed #EFE4E0;
  margin-bottom: 12rpx;
}

.example-text {
  font-size: 26rpx;
  color: #52464A;
  line-height: 1.6;
}

/* ── 生成按钮（固定底部）── */
.gen-bar {
  padding: 16rpx 40rpx calc(env(safe-area-inset-bottom, 0px) + 24rpx);
  background: #FAF4F1;
  border-top: 1rpx solid #EFE4E0;
  flex-shrink: 0;
}

.gen-btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-btn-on  { background: #E45A7E; }
.gen-btn-off { background: #EFE4E0; }

.btn-hover { opacity: 0.82; }

.gen-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.gen-btn-off .gen-btn-text { color: #BDB3B5; }

/* ══════════════════════════
   结果状态
══════════════════════════ */

/* 原文回显卡 */
.echo-card {
  margin: 24rpx 40rpx 0;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  border-radius: 24rpx;
}

.echo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.echo-label {
  font-size: 22rpx;
  color: #8F8589;
}

.echo-text {
  display: block;
  font-size: 26rpx;
  color: #52464A;
  line-height: 1.7;
}

/* ── Tab 切换 ── */
.tab-switcher {
  margin: 24rpx 40rpx 0;
  display: flex;
  gap: 8rpx;
  background: #FFF8F5;
  border-radius: 20rpx;
  padding: 8rpx;
  border: 1rpx solid #EFE4E0;
}

.tab-item {
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.tab-on {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tab-off { background: transparent; }

.tab-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #8F8589;
  line-height: 1.3;
}

.tab-label-on {
  color: #1F1417;
  font-weight: 600;
}

.tab-sub {
  font-size: 20rpx;
  line-height: 1;
}

.tab-sub-low    { color: #3D7A5A; }
.tab-sub-medium { color: #A07830; }
.tab-sub-high   { color: #9B4040; }

/* ── 结果卡 ── */
.result-card {
  margin: 20rpx 40rpx 0;
  padding: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  border-radius: 24rpx;
  min-height: 240rpx;
}

.result-text {
  display: block;
  font-size: 30rpx;
  color: #1F1417;
  line-height: 1.8;
  margin-bottom: 28rpx;
}

/* 操作行 */
.result-actions {
  display: flex;
  gap: 12rpx;
}

.action-copy {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  background: #E45A7E;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-copy-done { background: #3D7A5A; }

.action-copy-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.action-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EFE4E0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 32rpx;
  color: #52464A;
}

/* ── 锁定态：毛玻璃遮罩 ── */
.locked-container {
  position: relative;
  min-height: 360rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.result-text-blurred {
  filter: blur(6px);
  opacity: 0.5;
  user-select: none;
  pointer-events: none;
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(250, 244, 241, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  border-radius: 16rpx;
}

.lock-badge {
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  margin-bottom: 4rpx;
}

.lock-badge-icon {
  font-size: 32rpx;
  line-height: 1;
}

.lock-overlay-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  text-align: center;
}

.lock-overlay-sub {
  font-size: 22rpx;
  color: #8F8589;
  text-align: center;
  line-height: 1.5;
}

.lock-overlay-btn {
  margin-top: 8rpx;
  background: #E45A7E;
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
}

.lock-overlay-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 预测 Nudge ── */
.nudge-banner {
  margin: 24rpx 40rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FCE8EE;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nudge-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E45A7E;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nudge-icon {
  font-size: 24rpx;
  color: #FFFFFF;
}

.nudge-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.nudge-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #C73E64;
  line-height: 1.3;
}

.nudge-sub {
  display: block;
  font-size: 20rpx;
  color: #E45A7E;
  line-height: 1.4;
}

.nudge-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #E45A7E;
  flex-shrink: 0;
}

.nudge-btn-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* ══════════════════════════
   历史记录
══════════════════════════ */
.hist-fallback-tip {
  margin: 20rpx 40rpx 0;
  padding: 14rpx 24rpx;
  background: #FDF6E3;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hist-fallback-text {
  font-size: 22rpx;
  color: #A07830;
}

.hist-fallback-retry {
  font-size: 22rpx;
  color: #4A7B7B;
  font-weight: 600;
}

.hist-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.hist-empty-text {
  font-size: 28rpx;
  color: #BDB3B5;
}

.hist-item {
  margin: 20rpx 40rpx 0;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #EFE4E0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hist-item-hover { background: #FBF6F4; }

.hist-item-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hist-original {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F1417;
  line-height: 1.5;
}

.hist-date {
  font-size: 22rpx;
  color: #BDB3B5;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.hist-result {
  display: block;
  font-size: 24rpx;
  color: #8F8589;
  line-height: 1.6;
}

/* ── 升级引导弹窗 ── */
.upgrade-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.upgrade-modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.upgrade-modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-modal-close-icon {
  font-size: 44rpx;
  color: #C0BAB0;
  line-height: 1;
  font-weight: 300;
}

.upgrade-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
}

.upgrade-modal-body {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.7;
}

.upgrade-modal-email-wrap {
  background: #F5F3F0;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.upgrade-modal-email {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A7B7B;
  letter-spacing: 0.5rpx;
}

.upgrade-modal-copy-hint {
  font-size: 20rpx;
  color: #A0A0A0;
}

.email-hover {
  opacity: 0.7;
}

.upgrade-modal-btn {
  margin-top: 8rpx;
  width: 100%;
  background: #4A7B7B;
  border-radius: 999rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-modal-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
