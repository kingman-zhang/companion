/* P4 消息改写页样式 */

.page {
  min-height: 100vh;
  background: #F5F3F0;
}

/* ── 导航 ── */
.nav-bar {
  padding: 96rpx 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F3F0;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 100rpx;
}

.nav-hover { opacity: 0.6; }

.nav-back-icon {
  font-size: 44rpx;
  color: #1C1C1E;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-back-text {
  font-size: 30rpx;
  color: #1C1C1E;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.nav-placeholder {
  min-width: 100rpx;
}

/* ── 原文输入区 ── */
.input-section {
  padding: 24rpx 40rpx 32rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6B6B6B;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.original-input-wrap {
  background: #FAFAF8;
  border: 2rpx solid #E8E4DE;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.original-input-wrap.focused {
  border-color: #4A7B7B;
}

.original-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 30rpx;
  color: #1C1C1E;
  line-height: 1.7;
}

.input-placeholder {
  color: #ABABAB;
  font-size: 30rpx;
}

.char-count {
  display: block;
  font-size: 22rpx;
  color: #ABABAB;
  text-align: right;
  margin-top: 8rpx;
}

.rewrite-btn {
  background: #4A7B7B;
  height: 104rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rewrite-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.rewrite-btn-disabled {
  background: #E8E4DE;
}

.rewrite-btn-disabled text {
  color: #ABABAB;
}

/* ── 改写结果 ── */
.results {
  padding: 0 40rpx;
}

.variant-card {
  background: #FAFAF8;
  border: 1rpx solid #E8E4DE;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 24rpx rgba(0,0,0,0.06);
  overflow: hidden;
  position: relative;
  min-height: 200rpx;
}

/* ── 卡片头部 ── */
.variant-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.version-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.version-gentle { background: #EDF6F0; color: #2A5C40; }
.version-direct { background: #FDF6E3; color: #7A5820; }
.version-brief { background: #EEF1F6; color: #3A4A6B; }

.version-text { color: inherit; }

.risk-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.risk-low { background: #EDF6F0; color: #2A5C40; }
.risk-medium { background: #FDF6E3; color: #7A5820; }
.risk-high { background: #FBF0F0; color: #7A2A2A; }

.risk-text { color: inherit; }

/* ── 内容 ── */
.variant-content {
  display: block;
  font-size: 30rpx;
  color: #1C1C1E;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

/* ── 操作行 ── */
.variant-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommend-badge { display: inline-flex; align-items: center; }

.recommend-text {
  font-size: 24rpx;
  color: #3D7A5A;
}

.copy-btn {
  background: #F5F3F0;
  border: 1rpx solid #E8E4DE;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
}

.copy-text {
  font-size: 26rpx;
  color: #6B6B6B;
}

/* ── 付费遮罩 ── */
.paywall-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(245,243,240,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border-radius: 32rpx;
}

.lock-icon-wrap { margin-bottom: 16rpx; }

.lock-icon { font-size: 56rpx; }

.lock-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8rpx;
  text-align: center;
}

.lock-sub {
  display: block;
  font-size: 26rpx;
  color: #6B6B6B;
  margin-bottom: 28rpx;
  text-align: center;
}

.lock-btn {
  background: #4A7B7B;
  height: 80rpx;
  border-radius: 16rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-btn text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.btn-hover { opacity: 0.85; }

.page-bottom { height: 60rpx; }
