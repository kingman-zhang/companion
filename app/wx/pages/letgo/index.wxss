/* P7 放下模式页 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ═══════════ 导航栏 ═══════════ */
.nav {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44px 20rpx 16rpx;
  background: rgba(250, 241, 237, 0.92);
  border-bottom: 1rpx solid rgba(228, 210, 205, 0.84);
  backdrop-filter: blur(18rpx);
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.05);
}

.nav-btn-hover { background: rgba(0,0,0,0.06); }

.nav-back-icon {
  font-size: 48rpx;
  color: #52464A;
  line-height: 1;
}

.nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
}

.nav-subtitle {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}

.nav-placeholder { width: 72rpx; }

/* ═══════════ 确认区块 ═══════════ */
.confirm-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx 80rpx;
}

.confirm-pill {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.confirm-pill-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1;
}

.confirm-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #FFF1F5 0%, #FCE8EE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  box-shadow: 0 20rpx 40rpx rgba(199, 62, 100, 0.1);
}

.confirm-icon { font-size: 56rpx; }
.confirm-img  { width: 56rpx; height: 56rpx; }

.confirm-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 20rpx;
}

.confirm-body {
  font-size: 26rpx;
  color: #52464A;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 48rpx;
}

.confirm-btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.btn-hover { opacity: 0.82; }

.confirm-btn-primary-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.confirm-btn-ghost {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-hover { opacity: 0.6; }

.confirm-btn-ghost-text {
  font-size: 26rpx;
  color: #8F8589;
}

/* ═══════════ 滚动内容 ═══════════ */
.content { flex: 1; overflow: hidden; padding-top: 8rpx; }

/* ═══════════ 卡片通用 ═══════════ */
.section-card {
  margin: 0 32rpx 20rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  box-shadow: 0 16rpx 36rpx rgba(117, 77, 76, 0.06);
}

.card-hover { opacity: 0.88; }

.card-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.card-hd-icon { font-size: 32rpx; }
.card-hd-img  { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.card-hd-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  flex: 1;
}

.card-hd-sub {
  font-size: 22rpx;
  color: #8F8589;
  width: 100%;
  padding-left: 44rpx;
  margin-top: -16rpx;
  margin-bottom: 4rpx;
}

/* ═══════════ 断联建议 ═══════════ */
.tip-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.tip-dot {
  font-size: 28rpx;
  color: #E45A7E;
  line-height: 1.6;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #52464A;
  line-height: 1.6;
}

/* ═══════════ 告别信入口 ═══════════ */
.letter-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.letter-entry-left {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  flex: 1;
}

.letter-entry-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.letter-entry-sub {
  font-size: 22rpx;
  color: #8F8589;
  line-height: 1.4;
}

.letter-entry-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #FFF1F5;
  border-radius: 999rpx;
}

.letter-entry-btn-text {
  font-size: 24rpx;
  color: #C73E64;
  font-weight: 500;
}

/* ═══════════ 告别信编辑器 ═══════════ */
.editor-wrap { display: flex; flex-direction: column; gap: 20rpx; }

.editor-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.editor-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-close-icon {
  font-size: 24rpx;
  color: #8F8589;
}

.editor-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  line-height: 1.7;
  background: #FCF6F3;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.editor-placeholder {
  color: #BDB3B5;
  font-size: 26rpx;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
}

.editor-btn-ghost {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #E45A7E;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-btn-loading { opacity: 0.5; }

.editor-btn-ghost-text {
  font-size: 26rpx;
  color: #C73E64;
  font-weight: 500;
}

.editor-btn-primary {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-btn-primary-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ── 润色结果面板 ── */
.result-panel {
  background: #FCF6F3;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 4rpx;
}

.result-panel-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.result-panel-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #52464A;
}

.result-panel-close {
  font-size: 22rpx;
  color: #8F8589;
}

.result-variant {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(228, 210, 205, 0.84);
}

.result-variant:last-child { margin-bottom: 0; }

.result-variant-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #C73E64;
  margin-bottom: 8rpx;
}

.result-variant-content {
  display: block;
  font-size: 24rpx;
  color: #1C1C1E;
  line-height: 1.6;
}

/* ═══════════ 7天计划 ═══════════ */
/* ── 7天计划列表 ── */
.plan-item { border-top: 1rpx solid #F0EDE8; }
.plan-item:first-of-type { border-top: none; }

.plan-item-locked { opacity: 0.45; }

.plan-item-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

/* 徽章基础 */
.plan-day-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  min-width: 96rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

/* 普通（过去未操作） */
.badge-normal  { background: #F0EDE8; border-color: #F0EDE8; }
.badge-normal  .plan-day-text { color: #8F8589; }

/* 锁定 */
.badge-locked  { background: #F0EDE8; border-color: #F0EDE8; }
.badge-locked  .plan-day-text { color: #C0BAB0; }

/* 今日可操作：实心绿 */
.badge-today   { background: #E45A7E; border-color: #E45A7E; }
.badge-today   .plan-day-text { color: #FFFFFF; }

/* 已完成：浅绿实心 */
.badge-done    { background: #EDF6F0; border-color: #EDF6F0; }
.badge-done    .plan-day-text { color: #3D7A5A; font-weight: 600; }

/* 没做到：描边（无填充），暖黄 */
.badge-skip    { background: transparent; border-color: #C8A84B; }
.badge-skip    .plan-day-text { color: #A07830; font-weight: 500; }

.plan-day-text {
  font-size: 20rpx;
  font-weight: 500;
}

.plan-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #1C1C1E;
}
.plan-title-dim { color: #C0BAB0; }

.plan-chev {
  font-size: 36rpx;
  color: #BDB3B5;
  line-height: 1;
  transition: transform 0.2s;
}
.plan-chev-open { transform: rotate(90deg); }

/* 展开内容区 */
.plan-detail {
  padding-bottom: 20rpx;
  padding-left: 4rpx;
}

.plan-desc {
  display: block;
  font-size: 24rpx;
  color: #8F8589;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

/* 两按钮行 */
.plan-action-row {
  display: flex;
  gap: 16rpx;
}

.plan-btn-done {
  flex: 1;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.14);
}
.plan-btn-done-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.plan-btn-skip {
  flex: 1;
  border: 2rpx solid #C0BAB0;
  border-radius: 999rpx;
  padding: 16rpx 0;
  text-align: center;
}
.plan-btn-skip-text {
  font-size: 26rpx;
  color: #A0A0A0;
}

/* 操作记录标注 */
.plan-action-record {
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.plan-action-record-done {
  background: #EDF6F0;
}
.plan-action-record-done .plan-action-record-text {
  color: #3D7A5A;
}
.plan-action-record-skip {
  background: #FDF6E3;
}
.plan-action-record-skip .plan-action-record-text {
  color: #A07830;
}
.plan-action-record-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* ═══════════ 日志入口卡 ═══════════ */
.section-card-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 32rpx;
}

.section-action-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #52464A;
}

.section-action-tag {
  padding: 6rpx 16rpx;
  background: #F0EDE8;
  border-radius: 999rpx;
}

.section-action-tag-text {
  font-size: 20rpx;
  color: #8F8589;
}

.section-action-arrow {
  font-size: 36rpx;
  color: #BDB3B5;
  line-height: 1;
}

/* ═══════════ 底部区域 ═══════════ */
.footer-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin: 8rpx 32rpx 0;
}

.footer-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.footer-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.link-hover { opacity: 0.6; }

.footer-link {
  font-size: 22rpx;
  color: #BDB3B5;
  text-align: center;
}

/* ── 告别信完成面板 ── */
.letter-done-panel {
  margin-top: 28rpx;
  background: #FCF6F3;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
}

.letter-done-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 10rpx;
}

.letter-done-sub {
  font-size: 24rpx;
  color: #A0A0A0;
  line-height: 1.6;
  display: block;
  margin-bottom: 28rpx;
}

.letter-done-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.letter-done-btn-primary {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.14);
}

.letter-done-btn-primary-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.letter-done-btn-ghost {
  border: 2rpx solid #E45A7E;
  border-radius: 999rpx;
  padding: 22rpx 0;
  text-align: center;
}

.letter-done-btn-ghost-text {
  font-size: 26rpx;
  color: #C73E64;
}
