/* P1 问卷页样式 */

.page {
  height: 100vh;
  background: #EDE8DC;
  display: flex;
  flex-direction: column;
}

/* ── 顶部导航 ── */
/* padding-top / padding-right 由 JS 动态注入，避免与胶囊按钮重叠 */
.nav-bar {
  padding-left: 32rpx;
  padding-bottom: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 圆形返回键 */
.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  background: #FFFFFF;
  border-radius: 50%;
  border: 1.5rpx solid #D8D3CA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-btn-hover {
  opacity: 0.7;
}

.nav-home-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 分段进度条 */
.progress-segments {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.seg {
  flex: 1;
  height: 6rpx;
  border-radius: 3rpx;
}

.seg-filled {
  background: #4A7B7B;
}

.seg-empty {
  background: #C8C3BA;
}

/* Caption：10px = 20rpx */
.progress-counter {
  font-size: 20rpx;
  color: #A0A0A0;
  flex-shrink: 0;
  min-width: 48rpx;
  text-align: right;
}

/* ── 面包屑 ── */
.breadcrumb-row {
  padding: 20rpx 32rpx 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* Caption：10px = 20rpx */
.breadcrumb-text {
  font-size: 20rpx;
  color: #A0A0A0;
  line-height: 1.4;
}

.breadcrumb-sep {
  font-size: 20rpx;
  color: #C0BAB0;
}

/* ── 题目区域 ── */
.question-area {
  flex: 1;
  overflow: hidden;
}

/* Display 级大标题：22px = 44rpx */
.question-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.3;
  margin: 28rpx 32rpx 16rpx;
}

/* Secondary：12px = 24rpx */
.question-desc {
  display: block;
  font-size: 22rpx;
  color: #A8A49E;
  line-height: 1.6;
  margin: 0 32rpx 32rpx;
}

/* ── 选项 ── */
.options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 0 32rpx;
}

.option {
  background: #FFFFFF;
  border: 1.5rpx solid #E0DBD3;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.option-hover {
  opacity: 0.75;
}

.option-selected {
  border-color: #4A7B7B;
  border-width: 2rpx;
  background: #EEF4F4;
}

/* 左侧单选圆圈 */
.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #C8C4BC;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}

.radio-on {
  background: #4A7B7B;
  border-color: #4A7B7B;
}

.radio-check {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* 选项文字区 */
.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

/* Body：14px = 28rpx */
.option-label {
  font-size: 28rpx;
  color: #1C1C1E;
  font-weight: 500;
  line-height: 1.4;
}

.option-label-on {
  color: #2F6060;
  font-weight: 600;
}

/* Secondary：12px = 24rpx */
.option-subdesc {
  font-size: 22rpx;
  color: #A8A49E;
  line-height: 1.4;
}

/* ── 跳过按钮 ── */
.skip-btn {
  margin: 20rpx 32rpx 0;
  border: 1.5rpx dashed #C8C3BA;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skip-hover {
  opacity: 0.6;
}

/* Secondary */
.skip-text {
  font-size: 24rpx;
  color: #A8A49E;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  flex-shrink: 0;
  padding: 20rpx 32rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 左侧小方块返回键 */
.btn-back {
  width: 96rpx;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-back-hover {
  opacity: 0.7;
}

.btn-back-text {
  font-size: 40rpx;
  color: #3A3A3A;
  line-height: 1;
  margin-top: -2rpx;
}

/* 右侧主操作按钮 */
.btn-next {
  flex: 1;
  background: #4A7B7B;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-disabled {
  background: #C8C3BA;
}

.btn-hover {
  opacity: 0.85;
}

/* Body：14px = 28rpx */
.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

/* 安全区占位 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom, 0px);
  min-height: 40rpx;
  flex-shrink: 0;
}
