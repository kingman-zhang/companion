/* P1 问卷页样式 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 34%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ── 顶部导航 ── */
/* padding-top / padding-right 由 JS 动态注入，避免与胶囊按钮重叠 */
.nav-bar {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(250, 241, 237, 0.92);
  border-bottom: 1rpx solid rgba(228, 210, 205, 0.84);
  backdrop-filter: blur(18rpx);
}

/* 圆形返回键 */
.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  border: 1.5rpx solid rgba(219, 200, 195, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.06);
}

.nav-btn-hover {
  opacity: 0.7;
}

.nav-home-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 分段进度条 */
.progress-segments {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.seg {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
}

.seg-filled {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  box-shadow: 0 4rpx 10rpx rgba(199, 62, 100, 0.16);
}

.seg-empty {
  background: rgba(228, 214, 209, 0.9);
}

/* Caption：10px = 20rpx */
.progress-counter {
  font-size: 20rpx;
  color: #9B8A8E;
  flex-shrink: 0;
  min-width: 48rpx;
  text-align: right;
}

/* ── 面包屑 ── */
.breadcrumb-row {
  padding: 18rpx 32rpx 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

/* Caption：10px = 20rpx */
.breadcrumb-text {
  font-size: 20rpx;
  color: #9B8A8E;
  line-height: 1.4;
}

.breadcrumb-sep {
  font-size: 20rpx;
  color: #CBBABE;
}

.question-shell {
  flex: 1;
  margin: 20rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 36rpx;
  box-shadow: 0 18rpx 44rpx rgba(117, 77, 76, 0.065);
  backdrop-filter: blur(16rpx);
  overflow: hidden;
}

/* ── 题目区域 ── */
.question-area {
  flex: 1;
  overflow: hidden;
}

/* Display 级大标题：22px = 44rpx */
.question-title {
  display: block;
  font-size: 38rpx;
  font-weight: 650;
  color: #1F1417;
  line-height: 1.28;
  margin: 34rpx 36rpx 14rpx;
}

/* Secondary：12px = 24rpx */
.question-desc {
  display: block;
  font-size: 22rpx;
  color: #918489;
  line-height: 1.65;
  margin: 0 36rpx 32rpx;
}

/* ── 选项 ── */
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 0 28rpx;
}

.option {
  background: rgba(255, 255, 255, 0.9);
  border: 1.5rpx solid rgba(219, 200, 195, 0.8);
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(122, 71, 73, 0.04);
}

.option-hover {
  transform: translateY(-1rpx);
  opacity: 0.94;
}

.option-selected {
  border-color: rgba(228, 90, 126, 0.48);
  border-width: 2rpx;
  background: linear-gradient(180deg, #FFF4F7 0%, #FCE8EE 100%);
  box-shadow: 0 14rpx 30rpx rgba(199, 62, 100, 0.1);
}

/* 左侧单选圆圈 */
.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #CDBFC0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
}

.radio-on {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-color: #E45A7E;
}

.radio-check {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* 选项文字区 */
.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

/* Body：14px = 28rpx */
.option-label {
  font-size: 28rpx;
  color: #1C1C1E;
  font-weight: 500;
  line-height: 1.4;
}

.option-label-on {
  color: #C73E64;
  font-weight: 600;
}

/* Secondary：12px = 24rpx */
.option-subdesc {
  font-size: 22rpx;
  color: #93868B;
  line-height: 1.4;
}

/* ── 跳过按钮 ── */
.skip-btn {
  margin: 24rpx 28rpx 0;
  border: 1.5rpx dashed rgba(201, 167, 174, 0.85);
  border-radius: 22rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 249, 247, 0.76);
}

.skip-hover {
  opacity: 0.82;
}

/* Secondary */
.skip-text {
  font-size: 24rpx;
  color: #9B8A8E;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  flex-shrink: 0;
  padding: 18rpx 24rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 左侧小方块返回键 */
.btn-back {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(219, 200, 195, 0.7);
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.05);
}

.btn-back-hover {
  opacity: 0.7;
}

.btn-back-text {
  font-size: 40rpx;
  color: #3A3A3A;
  line-height: 1;
  margin-top: -2rpx;
}

/* 右侧主操作按钮 */
.btn-next {
  flex: 1;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 30rpx rgba(199, 62, 100, 0.18);
}

.btn-disabled {
  background: linear-gradient(135deg, #EBDDD8 0%, #E4D4CF 100%);
  box-shadow: none;
}

.btn-hover {
  opacity: 0.92;
  transform: translateY(-1rpx);
}

/* Body：14px = 28rpx */
.btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}

/* 安全区占位 */
.safe-area-bottom {
  height: env(safe-area-inset-bottom, 0px);
  min-height: 40rpx;
  flex-shrink: 0;
}
