<!-- P0 首页 -->
<view class="page">

  <!-- ── 顶部 Header ── -->
  <view class="header">
    <view class="header-brand">
      <view class="logo-icon">
        <view class="logo-dot-lg"></view>
        <view class="logo-dot-sm"></view>
      </view>
      <view class="logo-text-block">
        <text class="brand-name">伴听</text>
        <text class="brand-tagline">陪你慢慢想清楚</text>
      </view>
    </view>
  </view>

  <!-- ── 可滚动内容 ── -->
  <scroll-view class="content" scroll-y type="list" enhanced bounces="{{false}}">

    <!-- 问候语 -->
    <view class="greeting-wrap">
      <text class="greeting-meta">{{greeting}} · {{todayStr}}</text>
      <text class="greeting-title">先不用硬撑，我们慢慢来</text>
      <text class="greeting-sub">告诉我发生了什么，我们一起看看下一步</text>
      <view class="greeting-chips">
        <view class="greeting-chip">
          <text class="greeting-chip-text">先稳住情绪</text>
        </view>
        <view class="greeting-chip">
          <text class="greeting-chip-text">再判断关系</text>
        </view>
        <view class="greeting-chip">
          <text class="greeting-chip-text">最后决定表达</text>
        </view>
      </view>
    </view>

    <!-- 快速输入卡片 -->
    <view class="quick-card {{quickText.length > 0 ? 'quick-card-active' : ''}}">
      <textarea
        class="quick-input"
        value="{{quickText}}"
        bindinput="onQuickInput"
        placeholder="分手、挽回、冷战、不会回消息……都可以说"
        placeholder-class="quick-placeholder"
        auto-height
        adjust-position="{{true}}"
        maxlength="500"
      />
      <view class="quick-bar">
        <view class="quick-bar-left"></view>
        <view
          class="start-btn {{quickText.length > 0 ? 'start-btn-visible' : ''}}"
          bindtap="startQuickChat"
          hover-class="{{quickText.length > 0 ? 'start-hover' : ''}}"
          hover-stay-time="80"
        >
          <text class="start-text">开始聊聊 →</text>
        </view>
      </view>
    </view>

    <!-- 评估结果摘要卡（已完成评估时显示） -->
    <view
      wx:if="{{hasAssessment}}"
      class="assessment-card assessment-card-{{assessmentLevelCls}}"
      bindtap="goAssessment"
      hover-class="card-active"
      hover-stay-time="80"
    >
      <view class="acard-top">
        <view class="acard-score-block">
          <text class="acard-score">{{assessmentScore}}</text>
          <text class="acard-score-unit">分</text>
        </view>
        <view class="acard-badge acard-badge-{{assessmentLevelCls}}">
          <text class="acard-badge-text acard-badge-text-{{assessmentLevelCls}}">{{assessmentBadge}}</text>
        </view>
        <text class="acard-label">你的关系评估</text>
      </view>
      <text class="acard-insight" wx:if="{{assessmentInsight}}">"{{assessmentInsight}}"</text>
      <view class="acard-actions">
        <view class="acard-btn-primary" catchtap="goChat" hover-class="acard-btn-primary-hover" hover-stay-time="80">
          <text class="acard-btn-primary-text">继续聊聊</text>
        </view>
        <view class="acard-btn-ghost" hover-class="acard-ghost-hover" hover-stay-time="80">
          <text class="acard-btn-ghost-text">看看评估 ›</text>
        </view>
      </view>
    </view>

    <!-- 续接条（有未完成问卷时显示） -->
    <view
      wx:if="{{hasResume}}"
      class="resume-strip"
      bindtap="resumeQuestionnaire"
      hover-class="resume-hover"
      hover-stay-time="80"
    >
      <view class="resume-dot"></view>
      <view class="resume-body">
        <text class="resume-title">接着看完上次的评估</text>
        <text class="resume-sub">第 {{resumeStep}} / 7 题 · 进度已保存</text>
      </view>
      <text class="resume-arrow">›</text>
    </view>

    <!-- 场景区 header -->
    <view class="section-hd">
      <text class="section-hd-title">也可以从一个场景开始</text>
      <view hover-class="more-hover" hover-stay-time="80">
        <text class="section-hd-more">全部 ›</text>
      </view>
    </view>

    <!-- 场景卡片列表 -->
    <view class="scenario-list">
      <block wx:for="{{scenarios}}" wx:key="scene">

        <!-- Hero 卡（第一张，差异化设计） -->
        <view
          wx:if="{{index === 0}}"
          class="scenario-hero"
          bindtap="selectScenario"
          data-scene="{{item.scene}}"
          hover-class="card-active"
          hover-stay-time="80"
        >
          <view class="hero-icon-bg" style="background-color: {{item.iconBg}};">
            <text class="hero-emoji">{{item.emoji}}</text>
          </view>
          <view class="hero-content">
            <view class="hero-title-row">
              <text class="hero-title">{{item.title}}</text>
              <view
                wx:if="{{item.badge}}"
                class="badge"
                style="background-color: {{item.badgeBgColor}};"
              >
                <text class="badge-text" style="color: {{item.badgeTextColor}};">{{item.badge}}</text>
              </view>
            </view>
            <text class="hero-desc">{{item.desc}}</text>
            <view class="hero-cta">
              <text class="hero-cta-text">开始看看 →</text>
            </view>
          </view>
        </view>

        <!-- 普通卡（第二张起，带圆角 emoji 图标区） -->
        <view
          wx:else
          class="scenario-card"
          bindtap="selectScenario"
          data-scene="{{item.scene}}"
          hover-class="card-active"
          hover-stay-time="80"
        >
          <view class="card-icon-bg" style="background-color: {{item.iconBg}};">
            <text class="card-emoji">{{item.emoji}}</text>
          </view>
          <view class="card-body">
            <view class="card-title-row">
              <text class="card-title">{{item.title}}</text>
              <view
                wx:if="{{item.badge}}"
                class="badge"
                style="background-color: {{item.badgeBgColor}};"
              >
                <text class="badge-text" style="color: {{item.badgeTextColor}};">{{item.badge}}</text>
              </view>
            </view>
            <text class="card-desc">{{item.desc}}</text>
          </view>
          <text class="card-arrow">›</text>
        </view>

      </block>
    </view>

    <!-- 免责声明 -->
    <view class="disclaimer">
      <text class="disclaimer-text">🔒 端到端加密 · 不记录身份信息 · 不用于训练 · 可随时删除</text>
    </view>

    <view style="height: 24rpx;"></view>
  </scroll-view>


</view>
