/* P0 首页 — 玫瑰粉色系 */

/* 页面容器 */
.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 35%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 46%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ═══════════════════════════
   Header
═══════════════════════════ */
.header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--md-space-2);
  padding: 104rpx var(--md-space-5) 20rpx;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: var(--md-space-2);
  min-width: 0;
}

/* Logo 图标：玫瑰粉圆角正方形，内有两个白色圆点 */
.logo-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(145deg, #EB6F90 0%, #C73E64 100%);
  border-radius: var(--md-radius-md);
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 16rpx 30rpx rgba(199, 62, 100, 0.2);
}

.logo-dot-lg {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--md-radius-full);
  top: var(--md-space-2);
  left: var(--md-space-2);
}

.logo-dot-sm {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: var(--md-radius-full);
  bottom: var(--md-space-2);
  right: var(--md-space-2);
}

/* Logo 右侧文字块 */
.logo-text-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--md-space-1);
}

.brand-name {
  font-size: var(--md-font-body);
  font-weight: var(--md-weight-semibold);
  color: var(--md-text-primary);
  line-height: 1.25;
}

.brand-tagline {
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
  line-height: 1;
}


/* ═══════════════════════════
   可滚动内容
═══════════════════════════ */
.content {
  flex: 1;
  overflow: hidden;
}

/* ── 问候区 ── */
.greeting-wrap {
  padding: 12rpx var(--md-space-5) var(--md-space-3);
}

.greeting-meta {
  display: block;
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
  margin-bottom: var(--md-space-1);
  line-height: 1.4;
}

.greeting-title {
  display: block;
  font-size: var(--md-font-display);
  font-weight: var(--md-weight-semibold);
  color: var(--md-text-primary);
  line-height: 1.18;
}

.greeting-sub {
  display: block;
  font-size: var(--md-font-caption);
  color: var(--md-text-mid);
  line-height: 1.6;
  margin-top: 18rpx;
}

.greeting-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--md-space-3);
}

.greeting-chip {
  padding: 12rpx 18rpx;
  border-radius: var(--md-radius-pill);
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.greeting-chip-text {
  font-size: var(--md-font-hint);
  color: var(--md-text-mid);
  line-height: 1;
}

/* ── 快速输入卡片 ── */
.quick-card {
  margin: 0 var(--md-space-5) var(--md-space-3);
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  overflow: hidden;
  border: 2rpx solid rgba(222, 204, 199, 0.72);
  box-shadow: 0 18rpx 40rpx rgba(122, 71, 73, 0.07);
  backdrop-filter: blur(18rpx);
  transition: border-color 0.2s, transform 0.2s;
}

.quick-card-active {
  border-color: rgba(228, 90, 126, 0.38);
  transform: translateY(-1rpx);
}

.quick-input {
  display: block;
  width: 100%;
  min-height: 112rpx;
  padding: var(--md-space-3) var(--md-space-4) var(--md-space-2);
  font-size: var(--md-font-body);
  color: var(--md-text-primary);
  line-height: 1.65;
  box-sizing: border-box;
}

.quick-placeholder {
  color: var(--md-text-tertiary);
  font-size: var(--md-font-body);
}

/* 输入卡片底部操作栏 */
.quick-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--md-space-2) var(--md-space-3) var(--md-space-3);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(252, 240, 243, 0.84) 100%);
}

.quick-bar-left {
  display: flex;
  gap: var(--md-space-1);
}

.media-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--md-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-hover {
  background: var(--md-bg-page-warm);
}

.media-icon {
  font-size: var(--md-font-caption);
}

/* 开始按钮：无内容时隐藏，有内容时淡入 */
.start-btn {
  height: 64rpx;
  padding: 0 var(--md-space-4);
  border-radius: var(--md-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--md-color-brand) 0%, var(--md-color-brand-deep) 100%);
  opacity: 0;
  transform: scale(0.88);
  pointer-events: none;
  transition: opacity 0.18s ease, transform 0.18s ease;
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.2);
}

.start-btn-visible {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.start-hover {
  opacity: 0.82;
}

.start-text {
  font-size: var(--md-font-caption);
  font-weight: var(--md-weight-medium);
  color: #FFFFFF;
}

/* ── 评估结果摘要卡 ── */
.assessment-card {
  margin: 0 var(--md-space-5) var(--md-space-3);
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: var(--md-space-3) var(--md-space-4) var(--md-space-3);
  border: 1rpx solid var(--md-border-light);
  box-shadow: 0 16rpx 38rpx rgba(122, 71, 73, 0.06);
}

.assessment-card-green  { border-color: var(--md-assess-green-border);  background: var(--md-assess-green-card); }
.assessment-card-yellow { border-color: var(--md-assess-yellow-border); background: var(--md-assess-yellow-card); }
.assessment-card-red    { border-color: var(--md-assess-red-border);    background: var(--md-assess-red-card); }

.acard-top {
  display: flex;
  align-items: center;
  gap: var(--md-space-2);
  margin-bottom: var(--md-space-2);
}

.acard-score-block {
  display: flex;
  align-items: baseline;
  gap: var(--md-space-1);
}

.acard-score {
  font-size: var(--md-font-display);
  font-weight: var(--md-weight-semibold);
  color: var(--md-text-primary);
  line-height: 1;
}

.acard-score-unit {
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
}

.acard-badge {
  padding: var(--md-space-1) var(--md-space-2);
  border-radius: var(--md-radius-pill);
  flex-shrink: 0;
}

.acard-badge-green  { background: var(--md-assess-green-bg); }
.acard-badge-yellow { background: var(--md-assess-yellow-bg); }
.acard-badge-red    { background: var(--md-assess-red-bg); }

.acard-badge-text { font-size: var(--md-font-hint); font-weight: var(--md-weight-medium); }
.acard-badge-text-green  { color: var(--md-assess-green); }
.acard-badge-text-yellow { color: var(--md-assess-yellow); }
.acard-badge-text-red    { color: var(--md-assess-red); }

.acard-label {
  flex: 1;
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
  text-align: right;
}

.acard-insight {
  display: block;
  font-size: var(--md-font-caption);
  color: var(--md-text-mid);
  line-height: 1.6;
  margin-bottom: var(--md-space-3);
  font-style: italic;
}

.acard-actions {
  display: flex;
  align-items: center;
  gap: var(--md-space-3);
}

.acard-btn-primary {
  flex: 1;
  height: var(--md-space-8);
  background: linear-gradient(135deg, var(--md-color-brand) 0%, var(--md-color-brand-deep) 100%);
  border-radius: var(--md-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.16);
}

.acard-btn-primary-hover { opacity: 0.82; }

.acard-btn-primary-text {
  font-size: var(--md-font-caption);
  font-weight: var(--md-weight-medium);
  color: #FFFFFF;
}

.acard-btn-ghost {
  height: var(--md-space-8);
  padding: 0 var(--md-space-1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.acard-ghost-hover {
  opacity: 0.6;
}

.acard-btn-ghost-text {
  font-size: var(--md-font-caption);
  color: var(--md-text-secondary);
}

/* ── 续接条 ── */
.resume-strip {
  margin: 0 var(--md-space-5) var(--md-space-3);
  padding: var(--md-space-3) var(--md-space-3);
  border-radius: 24rpx;
  background: rgba(252, 232, 238, 0.88);
  border: 1rpx solid rgba(228, 90, 126, 0.16);
  display: flex;
  align-items: center;
  gap: var(--md-space-3);
  box-shadow: 0 14rpx 32rpx rgba(122, 71, 73, 0.05);
}

.resume-hover {
  opacity: 0.82;
}

.resume-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--md-radius-full);
  background: var(--md-color-brand);
  flex-shrink: 0;
}

.resume-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--md-space-1);
}

.resume-title {
  font-size: var(--md-font-body);
  font-weight: var(--md-weight-semibold);
  color: var(--md-color-brand-deep);
  line-height: 1.4;
}

.resume-sub {
  font-size: var(--md-font-hint);
  color: var(--md-color-brand);
  line-height: 1.4;
}

.resume-arrow {
  font-size: var(--md-font-h1);
  color: var(--md-color-brand);
  line-height: 1;
  flex-shrink: 0;
}

/* ── 场景区 Section Header ── */
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--md-space-1) var(--md-space-5) var(--md-space-2);
}

.section-hd-title {
  font-size: var(--md-font-caption);
  color: #6E6064;
  font-weight: var(--md-weight-semibold);
}

.section-hd-more {
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
}

.more-hover {
  opacity: 0.6;
}

/* ── 场景卡片列表 ── */
.scenario-list {
  margin: 0 var(--md-space-5);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

/* 通用按下反馈（assessment-card、hero、普通卡共用） */
.card-active {
  opacity: 0.94;
  transform: scale(0.992);
}

/* ── Hero 场景卡（第一张，差异化设计） ── */
.scenario-hero {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 246, 246, 0.92) 100%);
  border-radius: 32rpx;
  border: 1rpx solid rgba(228, 90, 126, 0.12);
  display: flex;
  align-items: flex-start;
  padding: var(--md-space-4);
  gap: var(--md-space-3);
  box-shadow: 0 18rpx 42rpx rgba(128, 66, 75, 0.08);
}

.hero-icon-bg {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--md-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-emoji {
  font-size: 48rpx;
}

.hero-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: var(--md-space-2);
  margin-bottom: var(--md-space-1);
  flex-wrap: wrap;
}

.hero-title {
  font-size: var(--md-font-body);
  font-weight: var(--md-weight-semibold);
  color: var(--md-text-primary);
  line-height: 1.4;
}

.hero-desc {
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
  line-height: 1.5;
  margin-bottom: var(--md-space-3);
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  background: linear-gradient(135deg, var(--md-color-brand) 0%, var(--md-color-brand-deep) 100%);
  border-radius: var(--md-radius-pill);
  height: 56rpx;
  padding: 0 var(--md-space-4);
  align-self: flex-start;
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.18);
}

.hero-cta-text {
  font-size: var(--md-font-caption);
  font-weight: var(--md-weight-medium);
  color: #FFFFFF;
}

/* ── 普通场景卡（第二张起，带圆角 emoji 图标区） ── */
.scenario-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  border: 1rpx solid rgba(222, 204, 199, 0.72);
  display: flex;
  align-items: center;
  min-height: 144rpx;
  overflow: hidden;
  padding-left: var(--md-space-3);
  gap: var(--md-space-3);
  box-shadow: 0 14rpx 32rpx rgba(128, 66, 75, 0.05);
}

.card-icon-bg {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--md-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-emoji {
  font-size: 32rpx;
}

.card-body {
  flex: 1;
  padding: var(--md-space-3) 0;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: var(--md-space-2);
  margin-bottom: var(--md-space-1);
  flex-wrap: wrap;
}

.card-title {
  font-size: var(--md-font-body);
  font-weight: var(--md-weight-semibold);
  color: var(--md-text-primary);
  line-height: 1.4;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: var(--md-space-1) var(--md-space-2);
  border-radius: var(--md-radius-pill);
  flex-shrink: 0;
}

.badge-text {
  font-size: var(--md-font-hint);
  font-weight: var(--md-weight-medium);
  line-height: 1;
}

.card-desc {
  font-size: var(--md-font-hint);
  color: var(--md-text-secondary);
  line-height: 1.5;
}

.card-arrow {
  font-size: var(--md-font-h1);
  color: var(--md-text-tertiary);
  line-height: 1;
  padding-right: var(--md-space-3);
  flex-shrink: 0;
}

/* ── 免责声明 ── */
.disclaimer {
  text-align: center;
  padding: var(--md-space-5) calc(var(--md-space-5) + 12rpx) 0;
}

.disclaimer-text {
  font-size: var(--md-font-hint);
  color: var(--md-text-tertiary);
  line-height: 1.6;
}
