/* P0 首页 — 玫瑰粉色系 */

/* 页面容器 */
.page {
  height: 100vh;
  background: #FAF4F1;
  display: flex;
  flex-direction: column;
}

/* ═══════════════════════════
   Header
═══════════════════════════ */
.header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 104rpx 40rpx 20rpx;
}

/* Logo 图标：玫瑰粉圆角正方形，内有两个白色圆点 */
.logo-icon {
  width: 64rpx;
  height: 64rpx;
  background: #E45A7E;
  border-radius: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.logo-dot-lg {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 14rpx;
  left: 16rpx;
}

.logo-dot-sm {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  bottom: 14rpx;
  right: 14rpx;
}

/* Logo 右侧文字块 */
.logo-text-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.25;
}

.brand-tagline {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}


/* ═══════════════════════════
   可滚动内容
═══════════════════════════ */
.content {
  flex: 1;
  overflow: hidden;
}

/* ── 问候区 ── */
.greeting-wrap {
  padding: 12rpx 40rpx 24rpx;
}

.greeting-meta {
  display: block;
  font-size: 24rpx;
  color: #8F8589;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.greeting-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.25;
  letter-spacing: -1rpx;
}

.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.5;
  margin-top: 10rpx;
}

/* ── 快速输入卡片 ── */
.quick-card {
  margin: 0 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  border: 3rpx solid #EFE4E0;
  transition: border-color 0.2s;
}

.quick-card-active {
  border-color: #E45A7E;
}

.quick-input {
  display: block;
  width: 100%;
  min-height: 112rpx;
  padding: 28rpx 32rpx 16rpx;
  font-size: 28rpx;
  color: #1F1417;
  line-height: 1.65;
  box-sizing: border-box;
}

.quick-placeholder {
  color: #BDB3B5;
  font-size: 28rpx;
}

/* 输入卡片底部操作栏 */
.quick-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx 20rpx;
}

.quick-bar-left {
  display: flex;
  gap: 8rpx;
}

.media-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-hover {
  background: #FAF4F1;
}

.media-icon {
  font-size: 26rpx;
}

/* 开始按钮 */
.start-btn {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.start-btn-off {
  background: #EFE4E0;
}

.start-btn-on {
  background: #E45A7E;
}

.start-hover {
  opacity: 0.82;
}

.start-text {
  font-size: 26rpx;
  font-weight: 500;
}

.start-text-off {
  color: #BDB3B5;
}

.start-text-on {
  color: #FFFFFF;
}

/* ── 评估结果摘要卡 ── */
.assessment-card {
  margin: 0 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx 24rpx;
  border: 1rpx solid #EFE4E0;
}

.assessment-card-green  { border-color: rgba(61, 122, 90, 0.25);  background: #F7FBF9; }
.assessment-card-yellow { border-color: rgba(160, 120, 48, 0.25); background: #FDFAF4; }
.assessment-card-red    { border-color: rgba(155, 64, 64, 0.25);  background: #FBF7F7; }

.acard-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.acard-score-block {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.acard-score {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1;
}

.acard-score-unit {
  font-size: 22rpx;
  color: #8F8589;
}

.acard-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.acard-badge-green  { background: #EDF6F0; }
.acard-badge-yellow { background: #FDF6E3; }
.acard-badge-red    { background: #FBF0F0; }

.acard-badge-text { font-size: 20rpx; font-weight: 500; }
.acard-badge-text-green  { color: #3D7A5A; }
.acard-badge-text-yellow { color: #A07830; }
.acard-badge-text-red    { color: #9B4040; }

.acard-label {
  flex: 1;
  font-size: 22rpx;
  color: #8F8589;
  text-align: right;
}

.acard-insight {
  display: block;
  font-size: 24rpx;
  color: #52464A;
  line-height: 1.6;
  margin-bottom: 22rpx;
  font-style: italic;
}

.acard-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.acard-btn-primary {
  flex: 1;
  height: 64rpx;
  background: #E45A7E;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.acard-btn-primary-hover { opacity: 0.82; }

.acard-btn-primary-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.acard-btn-ghost {
  height: 64rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.acard-btn-ghost-text {
  font-size: 24rpx;
  color: #8F8589;
}

/* ── 续接条 ── */
.resume-strip {
  margin: 0 40rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FCE8EE;
  border: 1rpx solid rgba(228, 90, 126, 0.2);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.resume-hover {
  opacity: 0.82;
}

.resume-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E45A7E;
  flex-shrink: 0;
}

.resume-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.resume-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #C73E64;
  line-height: 1.4;
}

.resume-sub {
  font-size: 22rpx;
  color: #E45A7E;
  line-height: 1.4;
}

.resume-arrow {
  font-size: 40rpx;
  color: #E45A7E;
  line-height: 1;
  flex-shrink: 0;
}

/* ── 场景区 Section Header ── */
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 40rpx 16rpx;
}

.section-hd-title {
  font-size: 24rpx;
  color: #52464A;
  font-weight: 600;
}

.section-hd-more {
  font-size: 22rpx;
  color: #8F8589;
}

.more-hover {
  opacity: 0.6;
}

/* ── 场景卡片列表 ── */
.scenario-list {
  margin: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scenario-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #EFE4E0;
  display: flex;
  align-items: center;
  min-height: 144rpx;
  overflow: hidden;
}

.card-active {
  opacity: 0.86;
}

/* 左侧色条 */
.accent-bar {
  width: 8rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin: 32rpx 24rpx 32rpx 18rpx;
  align-self: stretch;
}

.card-body {
  flex: 1;
  padding: 24rpx 0;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.4;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
}

.card-desc {
  font-size: 22rpx;
  color: #8F8589;
  line-height: 1.5;
}

.card-arrow {
  font-size: 40rpx;
  color: #BDB3B5;
  line-height: 1;
  padding-right: 24rpx;
  padding-left: 12rpx;
  flex-shrink: 0;
}

/* ── 免责声明 ── */
.disclaimer {
  text-align: center;
  padding: 36rpx 40rpx 0;
}

.disclaimer-text {
  font-size: 20rpx;
  color: #BDB3B5;
  line-height: 1.6;
}

