<!-- P3 情绪急救聊天页 -->
<view class="page">

  <!-- ── 顶部导航 ── -->
  <view class="nav-bar" style="padding-top: {{navPaddingTop}};">
    <view class="nav-back-btn" bindtap="goBack" hover-class="nav-btn-hover" hover-stay-time="100">
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-center">
      <text class="nav-title">聊聊现在的你</text>
      <text class="nav-subtitle">内容只保存在这台设备里</text>
    </view>
    <view class="nav-right">
      <view wx:if="{{emotionBadge}}" class="emotion-pill emotion-pill-{{emotionLevel}}">
        <text class="emotion-pill-text">{{emotionBadge}}</text>
      </view>
    </view>
  </view>

  <!-- ══════════════════════
       空状态（用户尚未发送消息）
  ══════════════════════ -->
  <view wx:if="{{!userHasSent}}" class="empty-body">

    <!-- 居中内容 -->
    <view class="empty-center">
      <view class="empty-intro-pill">
        <text class="empty-intro-pill-text">先把话说出来</text>
      </view>
      <!-- AI 头像 -->
      <view class="empty-avatar-wrap">
        <view class="empty-avatar">
          <view class="avatar-dot-l"></view>
          <view class="avatar-dot-r"></view>
          <view class="avatar-smile"></view>
        </view>
      </view>

      <text class="empty-title">先从一句话开始也可以</text>
      <text class="empty-desc">不着急。你想说什么都可以， 一个词、一句话、甚至只是发泄都行。</text>

      <!-- 快速发起 chips -->
      <view class="quick-chips">
        <view
          wx:for="{{quickPrompts}}"
          wx:key="index"
          class="quick-chip"
          bindtap="sendQuickPrompt"
          data-text="{{item}}"
          hover-class="chip-hover"
          hover-stay-time="80"
        >
          <text class="quick-chip-text">{{item}}</text>
        </view>
      </view>

      <!-- 安全声明 -->
      <view class="empty-safety">
        <text class="safety-text">我不是心理医生，但可以先陪你把思路理一理</text>
        <text class="safety-link">如果你有自伤念头，请先拨打 400-161-9995</text>
      </view>
    </view>

  </view>

  <!-- ══════════════════════
       聊天进行中
  ══════════════════════ -->
  <scroll-view
    wx:else
    class="msg-list"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
    enhanced
    bounces="{{false}}"
  >
    <!-- 顶部安全说明 -->
    <view class="chat-system-tip">
      <text class="system-tip-text">我不是心理医生，但会尽力陪你理清当下</text>
      <text class="system-tip-link">有自伤念头请拨打 400-161-9995</text>
    </view>

    <!-- 消息气泡 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="{{item.id}}"
      class="msg-row {{item.role === 'user' ? 'msg-row-user' : 'msg-row-ai'}}"
    >
      <!-- AI 消息 -->
      <block wx:if="{{item.role === 'assistant'}}">
        <view class="ai-avatar">
          <view class="ai-avatar-dot-l"></view>
          <view class="ai-avatar-dot-r"></view>
        </view>
        <view class="msg-bubble-wrap">
          <view class="msg-bubble msg-bubble-ai {{item.streaming ? 'msg-bubble-streaming' : ''}}">
            <!-- 流式占位：内容为空时显示打字动效 -->
            <block wx:if="{{item.streaming && !item.content}}">
              <view class="msg-typing-inner">
                <text class="typing-dot">·</text>
                <text class="typing-dot">·</text>
                <text class="typing-dot">·</text>
              </view>
            </block>
            <block wx:else>
              <text class="msg-text">{{item.content}}</text>
              <!-- 流式光标 -->
              <text wx:if="{{item.streaming}}" class="stream-cursor">▍</text>
            </block>
          </view>
        </view>
      </block>

      <!-- 用户消息 -->
      <block wx:else>
        <view class="msg-bubble-wrap">
          <view class="msg-bubble msg-bubble-user">
            <text class="msg-text msg-text-user">{{item.content}}</text>
          </view>
        </view>
        <view class="user-avatar">
          <text class="user-avatar-icon">我</text>
        </view>
      </block>
    </view>

    <!-- AI 正在输入（仅在流式气泡尚未出现时显示） -->
    <view class="msg-row msg-row-ai" wx:if="{{loading && !streamingActive}}">
      <view class="ai-avatar">
        <view class="ai-avatar-dot-l"></view>
        <view class="ai-avatar-dot-r"></view>
      </view>
      <view class="msg-bubble msg-bubble-ai msg-typing">
        <text class="typing-dot">·</text>
        <text class="typing-dot">·</text>
        <text class="typing-dot">·</text>
      </view>
    </view>

    <!-- Paywall 提示 -->
    <view class="paywall-banner" wx:if="{{showPaywall}}">
      <text class="paywall-title">已用完 10 轮免费对话</text>
      <text class="paywall-sub">升级后，可以继续不限次聊下去</text>
      <view class="paywall-btn" bindtap="showUpgradeModal" hover-class="btn-hover" hover-stay-time="100">
        <text class="paywall-btn-text">立即升级</text>
      </view>
    </view>

    <view class="list-bottom" id="list-bottom"></view>
  </scroll-view>

  <!-- ── 微干预卡片 ── -->
  <view class="micro-card" wx:if="{{showMicro && microIntervention}}">
    <view class="micro-header">
      <text class="micro-title">{{microIntervention.title}}</text>
      <view class="micro-close" bindtap="closeMicro" hover-class="nav-btn-hover" hover-stay-time="80">
        <text class="micro-close-icon">✕</text>
      </view>
    </view>
    <text class="micro-body">{{microIntervention.body}}</text>
    <view class="micro-actions">
      <view class="micro-btn-primary" bindtap="onMicroPrimary" hover-class="btn-hover" hover-stay-time="100">
        <text class="micro-btn-text-white">{{microIntervention.actionLabel}}</text>
      </view>
      <view
        wx:if="{{microIntervention.secondaryActionLabel}}"
        class="micro-btn-secondary"
        bindtap="onMicroSecondary"
        hover-class="btn-hover"
        hover-stay-time="100"
      >
        <text class="micro-btn-text-pink">{{microIntervention.secondaryActionLabel}}</text>
      </view>
    </view>
  </view>

  <!-- ── 快捷回复条（对话进行中时展示）── -->
  <scroll-view wx:if="{{userHasSent && !showPaywall}}" class="shortcuts-bar" scroll-x scroll-y="{{false}}">
    <view class="shortcuts-inner">
      <view
        wx:for="{{shortcuts}}"
        wx:key="index"
        class="shortcut-chip {{item.nav ? 'shortcut-chip-nav' : ''}}"
        bindtap="fillShortcut"
        data-text="{{item.text}}"
        data-nav="{{item.nav}}"
        hover-class="chip-hover"
        hover-stay-time="80"
      >
        <text class="shortcut-chip-text">{{item.text}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- ── 底部输入区 ── -->
  <view class="input-bar" wx:if="{{!showPaywall}}">
    <view class="input-wrap {{inputValue ? 'input-wrap-active' : ''}}">
      <input
        class="chat-input"
        value="{{inputValue}}"
        bindinput="onInput"
        placeholder="想说什么，就从这里开始"
        placeholder-class="input-placeholder"
        confirm-type="send"
        bindconfirm="sendMessage"
        adjust-position="{{true}}"
        maxlength="2000"
        disabled="{{loading}}"
      />
    </view>
    <view
      class="send-btn {{(!inputValue || loading) ? 'send-btn-off' : 'send-btn-on'}}"
      bindtap="sendMessage"
      hover-class="{{(!inputValue || loading) ? '' : 'btn-hover'}}"
      hover-stay-time="80"
    >
      <view class="send-icon-arrow"></view>
    </view>
  </view>

  <!-- ── 升级引导弹窗 ── -->
  <view wx:if="{{showUpgradeModal}}" class="upgrade-mask" bindtap="closeUpgradeModal">
    <view class="upgrade-modal" catchtap="noop">
      <view class="upgrade-modal-close" bindtap="closeUpgradeModal">
        <text class="upgrade-modal-close-icon">×</text>
      </view>
      <text class="upgrade-modal-title">功能还在准备中</text>
      <text class="upgrade-modal-body">这个功能还在完善里。想提前使用的话，可以先联系管理员开通。</text>
      <view class="upgrade-modal-email-wrap" bindtap="copyAdminEmail" hover-class="email-hover" hover-stay-time="80">
        <text class="upgrade-modal-email">diamondiamon@163.com</text>
        <text class="upgrade-modal-copy-hint">轻触复制</text>
      </view>
      <view class="upgrade-modal-btn" bindtap="closeUpgradeModal" hover-class="btn-hover" hover-stay-time="80">
        <text class="upgrade-modal-btn-text">知道了</text>
      </view>
    </view>
  </view>

</view>
