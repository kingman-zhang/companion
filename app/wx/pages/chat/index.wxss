/* P3 聊天页 — 玫瑰粉色系 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ══════════════════════════
   顶部导航
══════════════════════════ */
.nav-bar {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  background: rgba(250, 241, 237, 0.92);
  border-bottom: 1rpx solid rgba(228, 210, 205, 0.84);
  backdrop-filter: blur(18rpx);
}

.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(219, 200, 195, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.06);
}

.nav-btn-hover { opacity: 0.7; }

.nav-back-icon {
  font-size: 44rpx;
  color: #52464A;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.3;
}

.nav-subtitle {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}

.nav-right {
  flex-shrink: 0;
  min-width: 40rpx;
  display: flex;
  justify-content: flex-end;
}

/* 情绪强度徽章 */
.emotion-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.emotion-pill-high   { background: #FBF0F0; border-color: rgba(155, 64, 64, 0.14); }
.emotion-pill-medium { background: #FDF6E3; border-color: rgba(160, 120, 48, 0.14); }
.emotion-pill-low    { background: #E3EEDF; border-color: rgba(61, 122, 90, 0.14); }

.emotion-pill-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #52464A;
}

/* ══════════════════════════
   空状态
══════════════════════════ */
.empty-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.empty-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}

.empty-intro-pill {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.empty-intro-pill-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1;
}

/* AI 头像（大圆 + 粉底小脸）*/
.empty-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFF1F5 0%, #FCE8EE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(199, 62, 100, 0.1);
}

.empty-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  position: relative;
}

.avatar-dot-l {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 24rpx;
  left: 18rpx;
}

.avatar-dot-r {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 24rpx;
  right: 18rpx;
}

.avatar-smile {
  position: absolute;
  width: 28rpx;
  height: 12rpx;
  background: transparent;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-top: none;
  border-radius: 0 0 28rpx 28rpx;
  bottom: 18rpx;
  left: 50%;
  transform: translateX(-50%);
}

.empty-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #52464A;
  line-height: 1.7;
  margin-bottom: 36rpx;
  width: 100%;
  word-break: break-word;
}

/* 快速发起 chips */
.quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.quick-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  box-shadow: 0 8rpx 20rpx rgba(117, 77, 76, 0.04);
}

.chip-hover {
  opacity: 0.86;
  transform: translateY(-1rpx);
}

.quick-chip-text {
  font-size: 24rpx;
  color: #52464A;
}

/* 安全声明 */
.empty-safety {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
}

.safety-text {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1.6;
}

.safety-link {
  font-size: 20rpx;
  color: #E45A7E;
  line-height: 1.6;
  text-decoration: underline;
}

/* ══════════════════════════
   消息列表
══════════════════════════ */
.msg-list {
  flex: 1;
  overflow: hidden;
  padding-top: 0;
}

/* 顶部系统提示 */
.chat-system-tip {
  text-align: center;
  padding: 24rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.system-tip-text {
  font-size: 20rpx;
  color: #BDB3B5;
  line-height: 1.6;
}

.system-tip-link {
  font-size: 20rpx;
  color: #E45A7E;
  line-height: 1.6;
}

/* ── 消息行 ── */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 0 32rpx 24rpx;
  gap: 16rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-ai {
  justify-content: flex-start;
}

/* AI 头像（小，对话用）*/
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 10rpx 20rpx rgba(199, 62, 100, 0.14);
}

.ai-avatar-dot-l {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  left: 12rpx;
}

.ai-avatar-dot-r {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  right: 12rpx;
}

.msg-bubble-wrap {
  max-width: 76%;
}

/* ── 气泡 ── */
.msg-bubble {
  border-radius: 26rpx;
  padding: 20rpx 24rpx;
}

.msg-bubble-user {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-top-right-radius: 8rpx;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

/* 用户头像 */
.user-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #FCE8EE;
  border: 1rpx solid #F0CEDA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar-icon {
  font-size: 20rpx;
  font-weight: 600;
  color: #E45A7E;
  line-height: 1;
}

.msg-bubble-ai {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-top-left-radius: 8rpx;
  box-shadow: 0 12rpx 28rpx rgba(117, 77, 76, 0.05);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: #1F1417;
}

.msg-text-user {
  color: #FFFFFF;
}


/* ── 输入中动画 ── */
.msg-typing {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 20rpx 28rpx;
}

.typing-dot {
  font-size: 48rpx;
  color: #BDB3B5;
  line-height: 0.6;
  animation: typing 1.2s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* ── Paywall ── */
.paywall-banner {
  margin: 16rpx 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 28rpx;
  padding: 36rpx;
  text-align: center;
  box-shadow: 0 16rpx 38rpx rgba(117, 77, 76, 0.06);
}

.paywall-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  margin-bottom: 10rpx;
}

.paywall-sub {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  margin-bottom: 28rpx;
}

.paywall-btn {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.paywall-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.list-bottom { height: 32rpx; }

/* ══════════════════════════
   微干预卡片
══════════════════════════ */
.micro-card {
  margin: 0 32rpx 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(199, 62, 100, 0.1);
  flex-shrink: 0;
}

.micro-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.micro-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
}

.micro-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.micro-close-icon {
  font-size: 28rpx;
  color: #BDB3B5;
}

.micro-body {
  display: block;
  font-size: 28rpx;
  color: #52464A;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.micro-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.micro-btn-primary {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.micro-btn-text-white {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.micro-btn-secondary {
  border: 2rpx solid rgba(228, 90, 126, 0.4);
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.88);
}

.micro-btn-text-pink {
  font-size: 28rpx;
  color: #E45A7E;
}

/* ══════════════════════════
   快捷回复条
══════════════════════════ */
.shortcuts-bar {
  flex-shrink: 0;
  background: rgba(250, 241, 237, 0.92);
  border-top: 1rpx solid rgba(228, 210, 205, 0.84);
  white-space: nowrap;
  backdrop-filter: blur(18rpx);
}

.shortcuts-inner {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 24rpx;
}

.shortcut-chip {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(117, 77, 76, 0.04);
}

.shortcut-chip-text {
  font-size: 24rpx;
  color: #52464A;
  white-space: nowrap;
}

.shortcut-chip-nav {
  background: #FFF1F5;
  border-color: rgba(228, 90, 126, 0.16);
}

.shortcut-chip-nav .shortcut-chip-text {
  color: #C73E64;
}

/* ══════════════════════════
   输入区
══════════════════════════ */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 24rpx calc(env(safe-area-inset-bottom, 0px) + 20rpx);
  background: rgba(250, 241, 237, 0.94);
  border-top: 1rpx solid rgba(228, 210, 205, 0.72);
  flex-shrink: 0;
  backdrop-filter: blur(18rpx);
}

.input-wrap {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border: 1.5rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 24rpx rgba(117, 77, 76, 0.05);
  transition: border-color 0.2s;
}

.input-wrap-active {
  border-color: rgba(228, 90, 126, 0.34);
  box-shadow: 0 12rpx 28rpx rgba(199, 62, 100, 0.08);
}

.chat-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F1417;
  line-height: 1;
}

.input-placeholder {
  color: #C0BAB0;
  font-size: 28rpx;
}

/* 发送按钮：空→无底，有文字→粉圆；transition 实现动效 */
.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.18s ease, transform 0.18s ease;
}

.send-btn-on  {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  transform: scale(1);
  box-shadow: 0 12rpx 24rpx rgba(199, 62, 100, 0.18);
}

.send-btn-off {
  background: #efe4e0;
  transform: scale(1);
}

.btn-hover { opacity: 0.75; }
.btn-hover { transform: translateY(-1rpx); }

.send-icon-arrow {
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #C0BAB0;
  margin-left: 5rpx;
  flex-shrink: 0;
  transition: border-left-color 0.18s ease;
}

.send-btn-on  .send-icon-arrow { border-left-color: #FFFFFF; }
.send-btn-off .send-icon-arrow { border-left-color: #C0BAB0; }

/* ── 升级引导弹窗 ── */
.upgrade-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.upgrade-modal {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 24rpx 60rpx rgba(65, 33, 38, 0.16);
}

.upgrade-modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-modal-close-icon {
  font-size: 44rpx;
  color: #C0BAB0;
  line-height: 1;
  font-weight: 300;
}

.upgrade-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
}

.upgrade-modal-body {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.7;
}

.upgrade-modal-email-wrap {
  background: #FCF4F1;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.upgrade-modal-email {
  font-size: 28rpx;
  font-weight: 600;
  color: #C73E64;
  letter-spacing: 0.5rpx;
}

.upgrade-modal-copy-hint {
  font-size: 20rpx;
  color: #A0A0A0;
}

.email-hover {
  opacity: 0.7;
}

.upgrade-modal-btn {
  margin-top: 8rpx;
  width: 100%;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  border-radius: 999rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.upgrade-modal-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
