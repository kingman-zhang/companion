/* P3 聊天页 — 玫瑰粉色系 */

.page {
  height: 100vh;
  background: #FAF4F1;
  display: flex;
  flex-direction: column;
}

/* ══════════════════════════
   顶部导航
══════════════════════════ */
.nav-bar {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  background: #FAF4F1;
  border-bottom: 1rpx solid #EFE4E0;
}

.nav-back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-btn-hover { opacity: 0.7; }

.nav-back-icon {
  font-size: 44rpx;
  color: #52464A;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.3;
}

.nav-subtitle {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1;
}

.nav-right {
  flex-shrink: 0;
  min-width: 40rpx;
  display: flex;
  justify-content: flex-end;
}

/* 情绪强度徽章 */
.emotion-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.emotion-pill-high   { background: #FBF0F0; }
.emotion-pill-medium { background: #FDF6E3; }
.emotion-pill-low    { background: #E3EEDF; }

.emotion-pill-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #52464A;
}

/* ══════════════════════════
   空状态
══════════════════════════ */
.empty-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.empty-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}

/* AI 头像（大圆 + 粉底小脸）*/
.empty-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #FCE8EE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E45A7E;
  position: relative;
}

.avatar-dot-l {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 24rpx;
  left: 18rpx;
}

.avatar-dot-r {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 24rpx;
  right: 18rpx;
}

.avatar-smile {
  position: absolute;
  width: 28rpx;
  height: 12rpx;
  background: transparent;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-top: none;
  border-radius: 0 0 28rpx 28rpx;
  bottom: 18rpx;
  left: 50%;
  transform: translateX(-50%);
}

.empty-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #52464A;
  line-height: 1.7;
  margin-bottom: 40rpx;
  width: 100%;
  word-break: break-all;
}

/* 快速发起 chips */
.quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.quick-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
}

.chip-hover { opacity: 0.7; }

.quick-chip-text {
  font-size: 24rpx;
  color: #52464A;
}

/* 安全声明 */
.empty-safety {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
}

.safety-text {
  font-size: 20rpx;
  color: #8F8589;
  line-height: 1.6;
}

.safety-link {
  font-size: 20rpx;
  color: #E45A7E;
  line-height: 1.6;
  text-decoration: underline;
}

/* ══════════════════════════
   消息列表
══════════════════════════ */
.msg-list {
  flex: 1;
  overflow: hidden;
  padding-top: 0;
}

/* 顶部系统提示 */
.chat-system-tip {
  text-align: center;
  padding: 24rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.system-tip-text {
  font-size: 20rpx;
  color: #BDB3B5;
  line-height: 1.6;
}

.system-tip-link {
  font-size: 20rpx;
  color: #E45A7E;
  line-height: 1.6;
}

/* ── 消息行 ── */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin: 0 32rpx 24rpx;
  gap: 16rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-ai {
  justify-content: flex-start;
}

/* AI 头像（小，对话用）*/
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #E45A7E;
  position: relative;
  flex-shrink: 0;
}

.ai-avatar-dot-l {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  left: 12rpx;
}

.ai-avatar-dot-r {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  right: 12rpx;
}

.msg-bubble-wrap {
  max-width: 76%;
}

/* ── 气泡 ── */
.msg-bubble {
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.msg-bubble-user {
  background: #E45A7E;
  border-top-right-radius: 8rpx;
}

/* 用户头像 */
.user-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #FCE8EE;
  border: 1rpx solid #F0CEDA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar-icon {
  font-size: 20rpx;
  font-weight: 600;
  color: #E45A7E;
  line-height: 1;
}

.msg-bubble-ai {
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  border-top-left-radius: 8rpx;
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #1F1417;
}

.msg-text-user {
  color: #FFFFFF;
}


/* ── 输入中动画 ── */
.msg-typing {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 20rpx 28rpx;
}

.typing-dot {
  font-size: 48rpx;
  color: #BDB3B5;
  line-height: 0.6;
  animation: typing 1.2s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* ── Paywall ── */
.paywall-banner {
  margin: 16rpx 32rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  border-radius: 24rpx;
  padding: 36rpx;
  text-align: center;
}

.paywall-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  margin-bottom: 10rpx;
}

.paywall-sub {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  margin-bottom: 28rpx;
}

.paywall-btn {
  background: #E45A7E;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.paywall-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.list-bottom { height: 32rpx; }

/* ══════════════════════════
   微干预卡片
══════════════════════════ */
.micro-card {
  margin: 0 32rpx 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE4E0;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(228, 90, 126, 0.12);
  flex-shrink: 0;
}

.micro-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.micro-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
}

.micro-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.micro-close-icon {
  font-size: 28rpx;
  color: #BDB3B5;
}

.micro-body {
  display: block;
  font-size: 28rpx;
  color: #52464A;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.micro-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.micro-btn-primary {
  background: #E45A7E;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.micro-btn-text-white {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.micro-btn-secondary {
  border: 2rpx solid #E45A7E;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.micro-btn-text-pink {
  font-size: 28rpx;
  color: #E45A7E;
}

/* ══════════════════════════
   快捷回复条
══════════════════════════ */
.shortcuts-bar {
  flex-shrink: 0;
  background: #FAF4F1;
  border-top: 1rpx solid #EFE4E0;
  white-space: nowrap;
}

.shortcuts-inner {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 24rpx;
}

.shortcut-chip {
  display: inline-flex;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE2DE;
  flex-shrink: 0;
}

.shortcut-chip-text {
  font-size: 24rpx;
  color: #52464A;
  white-space: nowrap;
}

.shortcut-chip-nav {
  background: #EBF2F2;
  border-color: rgba(74,123,123,0.2);
}

.shortcut-chip-nav .shortcut-chip-text {
  color: #4A7B7B;
}

/* ══════════════════════════
   输入区
══════════════════════════ */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 24rpx calc(env(safe-area-inset-bottom, 0px) + 20rpx);
  background: #FAF4F1;
  flex-shrink: 0;
}

.input-wrap {
  flex: 1;
  background: #FFFFFF;
  border: 1.5rpx solid #EAE2DE;
  border-radius: 999rpx;
  padding: 0 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: border-color 0.2s;
}

.input-wrap-active {
  border-color: #D8B8C4;
}

.chat-input {
  flex: 1;
  font-size: 30rpx;
  color: #1F1417;
  line-height: 1;
}

.input-placeholder {
  color: #C0BAB0;
  font-size: 30rpx;
}

/* 发送按钮：空→无底，有文字→粉圆；transition 实现动效 */
.send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.18s ease, transform 0.18s ease;
}

.send-btn-on  { background: #E45A7E; transform: scale(1); }
.send-btn-off { background: #efe4e0; transform: scale(1); }

.btn-hover { opacity: 0.75; }

.send-icon-arrow {
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #C0BAB0;
  margin-left: 5rpx;
  flex-shrink: 0;
  transition: border-left-color 0.18s ease;
}

.send-btn-on  .send-icon-arrow { border-left-color: #FFFFFF; }
.send-btn-off .send-icon-arrow { border-left-color: #C0BAB0; }

/* ── 升级引导弹窗 ── */
.upgrade-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.upgrade-modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.upgrade-modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-modal-close-icon {
  font-size: 44rpx;
  color: #C0BAB0;
  line-height: 1;
  font-weight: 300;
}

.upgrade-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
}

.upgrade-modal-body {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.7;
}

.upgrade-modal-email-wrap {
  background: #F5F3F0;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
}

.upgrade-modal-email {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A7B7B;
  letter-spacing: 0.5rpx;
}

.upgrade-modal-copy-hint {
  font-size: 20rpx;
  color: #A0A0A0;
}

.email-hover {
  opacity: 0.7;
}

.upgrade-modal-btn {
  margin-top: 8rpx;
  width: 100%;
  background: #4A7B7B;
  border-radius: 999rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-modal-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
