/* 聊天历史列表页 */

.page {
  height: 100vh;
  background: #FAF4F1;
  display: flex;
  flex-direction: column;
}

/* ── 导航栏 ── */
.nav-bar {
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
  display: flex;
  align-items: center;
  background: #FAF4F1;
  border-bottom: 1rpx solid #EFE4E0;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1417;
  line-height: 1.3;
}

.nav-btn-hover { opacity: 0.75; }

/* ── 列表 ── */
.list {
  flex: 1;
  overflow: hidden;
}

.session-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: #FAF4F1;
  border-bottom: 1rpx solid #EFE4E0;
}

.card-hover { background: #F0EAE7; }

/* AI 小头像 */
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #E45A7E;
  position: relative;
  flex-shrink: 0;
}

.ai-dot-l {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  left: 12rpx;
}

.ai-dot-r {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  right: 12rpx;
}

.session-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.session-preview {
  font-size: 28rpx;
  color: #1F1417;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-meta {
  font-size: 22rpx;
  color: #A09898;
  line-height: 1;
}

.session-chev {
  font-size: 36rpx;
  color: #C8C4BC;
  flex-shrink: 0;
  line-height: 1;
}

/* ── 空状态 ── */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}

.empty-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FCE8EE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.empty-ai-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #E45A7E;
  position: relative;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1417;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.empty-cta {
  background: #E45A7E;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
}

.cta-hover { opacity: 0.8; }

.empty-cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 底部遮罩（防穿透）── */
.bottom-shield {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: #FAF4F1;
  z-index: 10;
}

/* ── 悬浮新建按钮 ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E45A7E;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(228, 90, 126, 0.40);
  z-index: 20;
}

.fab-hover { opacity: 0.82; transform: scale(0.95); }

.fab-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}
