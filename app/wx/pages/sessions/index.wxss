/* 聊天历史列表页 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ── 导航栏 ── */
.nav-bar {
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
  display: flex;
  align-items: center;
  background: rgba(250, 241, 237, 0.92);
  border-bottom: 1rpx solid rgba(228, 210, 205, 0.84);
  backdrop-filter: blur(18rpx);
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.3;
}

.nav-btn-hover { opacity: 0.75; }

/* ── 本地缓存提示 ── */
.local-fallback-tip {
  flex-shrink: 0;
  margin: 16rpx 24rpx 0;
  padding: 14rpx 24rpx;
  background: rgba(253, 246, 227, 0.92);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(160, 120, 48, 0.14);
}

.local-fallback-text {
  font-size: 22rpx;
  color: #A07830;
}

.local-fallback-retry {
  font-size: 22rpx;
  color: #C73E64;
  font-weight: 600;
}

/* ── 列表 ── */
.list {
  flex: 1;
  overflow: hidden;
}

.session-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 26rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(117, 77, 76, 0.05);
}

.card-hover { opacity: 0.9; }

/* AI 小头像 */
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 10rpx 20rpx rgba(199, 62, 100, 0.14);
}

.ai-dot-l {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  left: 12rpx;
}

.ai-dot-r {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  top: 18rpx;
  right: 12rpx;
}

.session-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.session-preview {
  font-size: 30rpx;
  color: #1F1417;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-meta {
  font-size: 22rpx;
  color: #A09898;
  line-height: 1;
}

.session-chev {
  font-size: 36rpx;
  color: #C8C4BC;
  flex-shrink: 0;
  line-height: 1;
}

/* ── 空状态 ── */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}

.empty-intro-pill {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.empty-intro-pill-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1;
}

.empty-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFF1F5 0%, #FCE8EE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  box-shadow: 0 20rpx 40rpx rgba(199, 62, 100, 0.1);
}

.empty-ai-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  position: relative;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1417;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.empty-cta {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.cta-hover { opacity: 0.8; }

.empty-cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 底部遮罩（防穿透）── */
.bottom-shield {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: rgba(250, 241, 237, 0.96);
  z-index: 10;
}

/* ── 悬浮新建按钮 ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(199, 62, 100, 0.28);
  z-index: 20;
}

.fab-hover { opacity: 0.82; transform: scale(0.95); }

.fab-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}
