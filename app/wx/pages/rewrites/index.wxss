/* 改写历史列表页 */

.page {
  height: 100vh;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
  display: flex;
  flex-direction: column;
}

/* ── 导航栏 ── */
.nav-bar {
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
  display: flex;
  align-items: center;
  background: rgba(250, 241, 237, 0.92);
  border-bottom: 1rpx solid rgba(228, 210, 205, 0.84);
  backdrop-filter: blur(18rpx);
}

.nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1417;
  line-height: 1.3;
}

.nav-btn-hover { opacity: 0.75; }

/* ── 列表 ── */
.list {
  flex: 1;
  overflow: hidden;
}

.rewrite-card {
  margin: 24rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(117, 77, 76, 0.06);
}

.card-hover { opacity: 0.9; }

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-date {
  font-size: 22rpx;
  color: #8F8589;
}

.card-chev-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-chev {
  font-size: 32rpx;
  color: #C8C4BC;
  line-height: 1;
}

/* 原文区块 */
.original-block {
  background: #FCF6F3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.block-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #A09898;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.original-text {
  display: block;
  font-size: 28rpx;
  color: #52464A;
  line-height: 1.6;
}

/* 箭头行 */
.arrow-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.arrow-down {
  font-size: 24rpx;
  color: #E45A7E;
  line-height: 1;
}

.arrow-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #E45A7E;
  letter-spacing: 1rpx;
}

/* 结果区块 */
.result-block {
  background: linear-gradient(180deg, #FFF4F7 0%, #FCE8EE 100%);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.result-text {
  display: block;
  font-size: 26rpx;
  color: #1F1417;
  line-height: 1.6;
}

/* ── 空状态 ── */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
}

.empty-intro-pill {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
}

.empty-intro-pill-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  line-height: 1;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1417;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.7;
  margin-bottom: 48rpx;
}

.empty-cta {
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 28rpx rgba(199, 62, 100, 0.16);
}

.cta-hover { opacity: 0.8; }

.empty-cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ── 底部遮罩（防穿透）── */
.bottom-shield {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: rgba(250, 241, 237, 0.96);
  z-index: 10;
}

/* ── 悬浮新建按钮 ── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E45A7E 0%, #C73E64 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(199, 62, 100, 0.28);
  z-index: 20;
}

.fab-hover { opacity: 0.82; }

.fab-icon {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}
