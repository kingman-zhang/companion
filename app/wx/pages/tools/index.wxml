<!-- 工具页 -->
<view class="page" style="padding-top: {{navPaddingTop}};">

  <view class="header">
    <view class="header-pill">
      <text class="header-pill-text">需要的时候，可以来这里看看</text>
    </view>
    <text class="header-title">支持工具</text>
    <text class="header-sub">在这段时间里，给你一些具体、能用上的支持</text>
  </view>

  <view class="tool-section">

    <view class="tool-card" bindtap="goLetgo" hover-class="card-hover" hover-stay-time="80">
      <view class="tool-icon-wrap teal">
        <image class="tool-img" src="/assets/icons/feat-leaf.png" mode="aspectFit"/>
      </view>
      <view class="tool-body">
        <text class="tool-name">放下模式</text>
        <text class="tool-desc">断联建议 · 告别信草稿 · 恢复计划</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>

    <view class="tool-card" bindtap="goLog" hover-class="card-hover" hover-stay-time="80">
      <view class="tool-icon-wrap amber">
        <image class="tool-img" src="/assets/icons/feat-notebook.png" mode="aspectFit"/>
      </view>
      <view class="tool-body">
        <text class="tool-name">每日日志</text>
        <text class="tool-desc">记录情绪状态 · 看看接下来怎么照顾自己</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>

    <view class="tool-card" bindtap="goFeedback" hover-class="card-hover" hover-stay-time="80">
      <view class="tool-icon-wrap rose">
        <view class="feedback-icon">
          <view class="feedback-icon-card">
            <view class="feedback-line feedback-line-top"></view>
            <view class="feedback-line feedback-line-mid"></view>
            <view class="feedback-line feedback-line-btm"></view>
          </view>
          <view class="feedback-badge">
            <view class="feedback-badge-dot"></view>
          </view>
        </view>
      </view>
      <view class="tool-body">
        <text class="tool-name">反馈与联系我</text>
        <text class="tool-desc">遇到问题可以反馈，想合作也可以通过邮件联系我</text>
      </view>
      <text class="tool-arrow">›</text>
    </view>

  </view>

</view>
