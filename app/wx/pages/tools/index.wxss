/* 工具页 */
page {
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(180deg, #FFF8F5 0%, #FAF1ED 48%, #F6EEEA 100%);
}

.page {
  min-height: 100vh;
  background: transparent;
}

.header {
  padding: 36rpx 40rpx 30rpx;
}

.header-pill {
  display: inline-flex;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(228, 90, 126, 0.12);
  margin-bottom: 18rpx;
}

.header-pill-text {
  font-size: 22rpx;
  color: #9A6C79;
  line-height: 1;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1417;
  display: block;
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: 26rpx;
  color: #8F8589;
  line-height: 1.6;
}

.tool-section {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid rgba(228, 210, 205, 0.84);
  box-shadow: 0 16rpx 36rpx rgba(117, 77, 76, 0.06);
}

.card-hover {
  opacity: 0.94;
  transform: translateY(-1rpx);
}

.tool-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(117, 77, 76, 0.05);
}

.teal { background: linear-gradient(180deg, #FFF1F5 0%, #FCE8EE 100%); }
.amber { background: linear-gradient(180deg, #FFF7EA 0%, #FDF6E3 100%); }

.tool-icon {
  font-size: 44rpx;
}

.tool-img {
  width: 52rpx;
  height: 52rpx;
}

.tool-body {
  flex: 1;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1417;
  display: block;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #8F8589;
  line-height: 1.55;
}

.tool-arrow {
  font-size: 40rpx;
  color: #C0BAB0;
  flex-shrink: 0;
}
